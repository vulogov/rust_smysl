@decision d/g0b8d3cda3398-11 { status: speculative, "code:kind": act, "ingest:quote": let seeds: Vec<usize> = cargo_smysl_verdict::check::AGREEMENT_SEEDS.iter().copied().cycle().take(c.passes.max(1)).collect(); }

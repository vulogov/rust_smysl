@constraint p/gb380a5ca16c9-9-2 { status: cited, source: { kind: file, ref: crates/cargo-smysl/src/commands.rs@b380a5ca16c9 }, "code:kind": existing-behaviour, "ingest:quote": "let mut done = 0;\nfor (n, sha) in todo.iter().enumerate() {\n    println!(\n        \"\\n[{}/{}] {}\",\n        n + 1,\n        todo.len(),\n        short(sha)\n    );\n    let code = extract(args, Some(sha), r.force, r.dry_run, how);\n    if code != exit::OK {\n        // One commit failing is not the run failing: the rest are still worth recording.\n        eprintln!(\"cargo smysl extract: {} failed; carrying on\", short(sha));\n        continue;\n    }\n    done += 1;\n}" }

@decision d/gdec7c232f8ba-2 { status: cited, source: { kind: doc, ref: git:dec7c232f8ba12e6d1096633ddceb1642bc2ca45 }, "code:kind": act, "ingest:quote": Reporting what was left out costs nothing and is honest. }

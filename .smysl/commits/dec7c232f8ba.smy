@decision d/gdec7c232f8ba-4 { status: cited, source: { kind: doc, ref: git:dec7c232f8ba12e6d1096633ddceb1642bc2ca45 }, "code:kind": act, "ingest:quote": "Splitting the change across calls triples the cost and should wait until the two cheap ones are measured, because they may make it unnecessary." }

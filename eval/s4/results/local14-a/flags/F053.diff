diff --git a/tests/cmd_check_default_store.rs b/tests/cmd_check_default_store.rs
new file mode 100644
index 0000000..51be653
--- /dev/null
+++ b/tests/cmd_check_default_store.rs
@@ -0,0 +1,90 @@
+//! `smysl check` with no path argument.
+//!
+//! Every other zero-argument command either reads stdin (`fmt`) or refuses with "no store
+//! given". `check` used to join `fmt` on stdin; it now reads `.smysl/store` instead, since a
+//! bare `check` is typically run in a project directory to ask whether the store being built
+//! there is still consistent, not fed through a pipe.
+
+#![cfg(feature = "cli")]
+
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const F1: &str = "fixtures/corpus/F1-incident.smy";
+
+const SUCCESS: i32 = 0;
+const FAILURE: i32 = 1;
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+/// A directory of this test's own, so two runs — or two tests — cannot collide.
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!(
+        "smysl-check-default-store-{name}-{}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+/// Run `check` with no arguments at all, from `dir`, stdin closed so a mistaken fall back to
+/// stdin hangs the test rather than reading nothing.
+fn check_bare(dir: &std::path::Path) -> Out {
+    let o = Command::new(BIN)
+        .arg("check")
+        .current_dir(dir)
+        .stdin(Stdio::null())
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+/// A bare `check`, run where `.smysl/store` holds a clean store, succeeds against it.
+#[test]
+fn bare_check_reads_the_default_store() {
+    let dir = scratch("present");
+    let smysl_dir = dir.join(".smysl");
+    std::fs::create_dir_all(&smysl_dir).expect("create .smysl");
+    let fixture = std::fs::read_to_string(F1).expect("read fixture");
+    std::fs::write(smysl_dir.join("store"), &fixture).expect("write default store");
+
+    let out = check_bare(&dir);
+    assert_eq!(
+        out.code, SUCCESS,
+        "stdout: {}\nstderr: {}",
+        out.stdout, out.stderr
+    );
+    assert!(
+        out.stdout.contains(".smysl/store") || out.stdout.contains("store"),
+        "check should report against the path it read: {}",
+        out.stdout
+    );
+}
+
+/// A bare `check`, run where `.smysl/store` does not exist, fails on that path rather than
+/// hanging on stdin.
+#[test]
+fn bare_check_fails_when_the_default_store_is_absent() {
+    let dir = scratch("absent");
+
+    let out = check_bare(&dir);
+    assert_eq!(
+        out.code, FAILURE,
+        "stdout: {}\nstderr: {}",
+        out.stdout, out.stderr
+    );
+    assert!(
+        out.stderr.contains(".smysl/store") || out.stderr.contains("store"),
+        "the error should name the default path: {}",
+        out.stderr
+    );
+}

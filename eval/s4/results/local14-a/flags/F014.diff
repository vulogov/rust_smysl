     let q = ticks_in_nanos(1).ok_or_else(|| TimeError::new(ucal_core::Code::E0021))?;
@@ -590,4 +654,53 @@ mod tests {
             );
         }
     }
+
+    /// `session_drift` reports a magnitude and a direction, and the magnitude
+    /// is small: this process anchored moments ago, so there has been no time
+    /// for real drift, only however long the test itself has taken.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn session_drift_is_small_for_a_fresh_process() {
+        let d = session_drift().expect("session drift");
+        let get = |key: &str| {
+            d.iter()
+                .find(|(k, _)| k == key)
+                .unwrap_or_else(|| panic!("no `{key}`"))
+                .1
+                .clone()
+        };
+
+        // `Value::Number` holds an ungrouped decimal string; grouping is a
+        // rendering concern applied later, on the way to text (Rule R).
+        let drift_ns: u128 = match get("drift_ns") {
+            Value::Number(s) => s.parse().expect("drift_ns is a number"),
+            other => panic!("expected a number, got {other:?}"),
+        };
+        assert!(
+            drift_ns < 60_000_000_000,
+            "a fresh session should not have drifted a minute: {drift_ns} ns"
+        );
+        assert!(get("system_clock").rendered_text().contains("projection"));
+        assert!(get("note").rendered_text().contains("Session"));
+    }
+
+    /// However far apart the two clocks are, `divergence` never claims the
+    /// magnitude is negative — Rule B makes a tick count unsigned, so a
+    /// second read of `session_drift` right after the first must still parse
+    /// and still carry a direction, not a sign.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn session_drift_is_stable_across_repeated_reads() {
+        for _ in 0..3 {
+            let d = session_drift().expect("session drift");
+            let (_, v) = d
+                .iter()
+                .find(|(k, _)| k == "drift_ns")
+                .expect("no `drift_ns`");
+            let Value::Number(s) = v else {
+                panic!("expected a number, got {v:?}");
+            };
+            let _: u128 = s.parse().expect("drift_ns is a number");
+        }
+    }
 }

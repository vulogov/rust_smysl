+/// How far this process's session clock has drifted from the system clock,
+/// for `ucal doctor --clock`.
+///
+/// Reads the same session [`session_now`] does — anchoring it on first use if
+/// nothing has asked the time yet this run — and calls [`Session::divergence`]
+/// between its projection and a fresh read of the system clock.
+///
+/// # Why this is usually near zero
+///
+/// `doctor` is a one-shot command: it anchors the session and reads it back
+/// within the same invocation, so the gap is dominated by however long this
+/// process happened to take between the two reads, not by any real rate
+/// error. The mechanism exists for a process that keeps a session open for
+/// longer — `ucal wallclock`, running for as long as it is left up — where
+/// the anchor and this read can be far apart and the wall clock underneath
+/// may have stepped. `doctor --clock` reports what the mechanism sees in
+/// *this* process, honestly, rather than fabricating a longer baseline.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn session_drift() -> Result<Vec<(String, Value)>, TimeError> {
+    let wall = crate::wall_instant()?;
+    let mut g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let (sess, base) = g.get_or_insert_with(|| {
+        (Session::anchored_at(&wall), std::time::Instant::now())
+    });
+    let elapsed = ticks_in_nanos(base.elapsed().as_nanos())
+        .ok_or_else(|| TimeError::new(ucal_core::Code::E0021))?;
+    let (magnitude, wall_ahead) = sess.divergence(&wall, &elapsed);
+
+    // Both operands of `divergence` are exact multiples of one nanosecond in
+    // ticks — one from `wall_instant`'s `SubSecond::new(nanos, 9)`, the other
+    // built by `ticks_in_nanos` — so the magnitude is too, and this division
+    // loses nothing.
+    let per_second = UC1::bridge().ticks;
+    let billion = <Ticks as TickInt>::from_u64(1_000_000_000);
+    let (per_nano, _) = per_second.quot_rem(&billion);
+    let (drift_ns, _) = magnitude.quot_rem(&per_nano);
+
+    let system_clock = if magnitude.is_zero_ticks() {
+        "in step with the session's projection".to_string()
+    } else if wall_ahead {
+        format!("{} ns ahead of the session's projection", drift_ns.to_dec_string())
+    } else {
+        format!("{} ns behind the session's projection", drift_ns.to_dec_string())
+    };
+
+    Ok(vec![
+        ("drift_ns".into(), Value::number(drift_ns.to_dec_string())),
+        ("system_clock".into(), Value::text(system_clock)),
+        (
+            "note".into(),
+            Value::text(
+                "the session clock (Session) never moves backwards; this is the gap \
+                 between its current projection and a fresh read of the system clock, \
+                 sampled now. Near zero here because `doctor` reads both within one \
+                 invocation — a longer-lived session, such as `ucal wallclock`, is where \
+                 this number becomes worth watching",
+            ),
+        ),
+    ])
+}

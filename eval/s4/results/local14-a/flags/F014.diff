+/// `ucal doctor --clock` adds a `session_drift` section: how far the session
+/// clock has drifted from the system clock, on top of the sampled resolutions
+/// `--clock` already reported. Not part of the byte-for-byte golden example —
+/// same reason `clock_measured` itself is not — because it is sampled.
+#[cfg(all(feature = "std", feature = "civil"))]
+#[test]
+fn doctor_clock_reports_session_drift() {
+    let doc = cmd_doctor_measuring().unwrap();
+    let measured = match doc.get("clock_measured") {
+        Some(Value::Section(fields)) => fields,
+        other => panic!("expected `clock_measured` to be a section, got {other:?}"),
+    };
+    let drift = measured
+        .iter()
+        .find(|(k, _)| k == "session_drift")
+        .map(|(_, v)| v)
+        .unwrap_or_else(|| panic!("`clock_measured` is missing `session_drift`"));
+    let Value::Section(fields) = drift else {
+        panic!("expected `session_drift` to be a section, got {drift:?}");
+    };
+    for required in ["drift_ns", "system_clock", "note"] {
+        assert!(
+            fields.iter().any(|(k, _)| k == required),
+            "`session_drift` is missing `{required}`"
+        );
+    }
+}

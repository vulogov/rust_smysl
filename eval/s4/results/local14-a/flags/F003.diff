+    /// Exercises both branches of `default_path` in one test rather than two, because both
+    /// mutate the same process-global environment variable and cargo runs tests in this
+    /// binary on shared threads.
+    #[test]
+    fn default_path_is_rooted_at_home_and_falls_back_without_one() {
+        let var = home_var();
+        let original = std::env::var_os(var);
+
+        std::env::set_var(var, "/home/a-smysl-user");
+        assert_eq!(
+            Ledger::default_path(),
+            PathBuf::from("/home/a-smysl-user/.smysl/usage.log"),
+            "a project's ledger should live under the home directory, not the checkout"
+        );
+
+        std::env::remove_var(var);
+        assert_eq!(
+            Ledger::default_path(),
+            PathBuf::from(".smysl/usage.log"),
+            "without a home directory, fall back to the plain relative path"
+        );
+
+        match original {
+            Some(v) => std::env::set_var(var, v),
+            None => std::env::remove_var(var),
+        }
+    }
+
+    #[test]
+    fn an_empty_home_variable_is_treated_as_absent() {
+        let var = home_var();
+        let original = std::env::var_os(var);
+
+        std::env::set_var(var, "");
+        assert_eq!(Ledger::default_path(), PathBuf::from(".smysl/usage.log"));
+
+        match original {
+            Some(v) => std::env::set_var(var, v),
+            None => std::env::remove_var(var),
+        }
+    }
 }

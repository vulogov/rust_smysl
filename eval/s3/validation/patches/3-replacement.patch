+/// The usage ledger lives in the user's home, so `smysl usage` totals spending across every
+/// project rather than per directory.
+#[cfg(feature = "providers")]
+fn user_ledger() -> std::path::PathBuf {
+    std::env::var_os("HOME")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| std::path::PathBuf::from("."))
+        .join(smysl::Ledger::PATH)
+}

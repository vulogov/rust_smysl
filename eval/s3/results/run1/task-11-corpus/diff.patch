+/// Writes [`OBSERVATIONS_FIXTURE`] at the exact relative path the `ephem
+/// residuals` example names, and removes it again on drop.
+///
+/// A committed copy of this file once caused a flaky test: two test binaries
+/// wrote the same fixed temp path concurrently and raced (1.12.0). Generating
+/// the manual has no such concurrency — one process, one call to
+/// [`generate`] — so writing it here and cleaning it up via `Drop` (which
+/// runs even when an earlier example's `capture` fails and `generate` returns
+/// early) is safe, and the fixture no longer sits in the tree only to
+/// demonstrate one command.
+struct ObservationsFixture {
+    path: std::path::PathBuf,
+}
+
+impl ObservationsFixture {
+    fn write(root: &Path) -> Result<Self, String> {
+        let path = root.join("Documentation/examples/observations.txt");
+        std::fs::write(&path, OBSERVATIONS_FIXTURE).map_err(|e| format!("{}: {e}", path.display()))?;
+        Ok(Self { path })
+    }
+}
+
+impl Drop for ObservationsFixture {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}

+const OBSERVATIONS_FIXTURE: &str = "\
+# Observed instants, one decimal tick count per line, for
+# `ucal ephem residuals Documentation/examples/ephemeris.hjson --observed <this>`.
+#
+# Blank lines and lines starting with `#` are skipped. Reading none at all is
+# an error rather than a report of agreement having compared nothing.
+#
+# THESE ARE SYNTHETIC, like the ephemeris they go with: each is the predicted
+# centre of a cycle, moved by a stated number of seconds, so the residuals are
+# known in advance and the arithmetic can be checked by eye.

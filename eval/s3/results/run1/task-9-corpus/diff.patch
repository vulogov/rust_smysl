+/// Every release note's version, parsed from its filename — newest first.
+///
+/// Sorted by [`parse_version`], not by the filename string: string order puts
+/// `1.10.0` between `1.1.0` and `1.2.0`, which is the same defect class
+/// `check_ci_covers_the_procedure` was fixed for (§`workspace_version` in
+/// `citations.rs`) — a two-digit minor did not exist until 1.10.0 shipped, so
+/// filename order and version order agreed until then.
+fn note_versions(root: &Path) -> Result<Vec<String>, String> {
+    let dir = root.join("Documentation/Release_Notes");
+    let entries = std::fs::read_dir(&dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let mut versions = Vec::new();
+    for e in entries.flatten() {
+        let path = e.path();
+        if path.extension().and_then(|s| s.to_str()) != Some("md") {
+            continue;
+        }
+        let Some(stem) = path.file_stem().and_then(|s| s.to_str()) else {
+            continue;
+        };
+        if stem == "README" {
+            continue;
+        }
+        if parse_version(stem).is_none() {
+            return Err(format!(
+                "{} is not named for a semantic version (X.Y.Z)",
+                path.display()
+            ));
+        }
+        versions.push(stem.to_string());
+    }
+    if versions.is_empty() {
+        return Err(format!("no release notes found under {}", dir.display()));
+    }
+    versions.sort_by_key(|v| std::cmp::Reverse(parse_version(v).expect("checked above")));
+    Ok(versions)
+}
+
+/// The Contents table must list every release note, newest first by parsed
+/// semantic version.
+///
+/// The table is maintained by hand — `README.md`'s "Closing a cycle" procedure
+/// says only "add the row to the table above" — and a row added in the wrong
+/// place reads fine to a skim. Comparing against [`note_versions`] catches both
+/// a misordered row and a row that does not match the notes on disk at all
+/// (missing, or naming a version with no file).
+pub fn check_notes_sorted(root: &Path) -> Result<usize, Vec<String>> {
+    let want = note_versions(root).map_err(|e| vec![e])?;
+    let table = rows(root).map_err(|e| vec![e])?;
+    let got: Vec<String> = table.iter().map(|r| r.version.clone()).collect();
+    if got == want {
+        Ok(got.len())
+    } else {
+        Err(vec![format!(
+            "the Contents table is not sorted by parsed semantic version, newest \
+             first (or does not match the notes on disk)\n            table:  {}\n            wanted: {}",
+            got.join(", "),
+            want.join(", ")
+        )])
+    }
+}

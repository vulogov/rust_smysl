+#[cfg(test)]
+mod sort_tests {
+    use super::*;
+
+    fn scratch(name: &str) -> std::path::PathBuf {
+        let dir = std::env::temp_dir().join(name);
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("Documentation/Release_Notes")).expect("mkdir");
+        dir
+    }
+
+    fn write_note(dir: &Path, version: &str) {
+        std::fs::write(
+            dir.join("Documentation/Release_Notes").join(format!("{version}.md")),
+            "notes\n",
+        )
+        .expect("write note");
+    }
+
+    fn write_readme(dir: &Path, rows: &[&str]) {
+        let mut s = String::from("# Release notes\n\n## Contents\n\n| version | date | state |\n|---|---|---|\n");
+        for v in rows {
+            s.push_str(&format!("| [{v}]({v}.md) | 2026-01-01 | released |\n"));
+        }
+        std::fs::write(dir.join("Documentation/Release_Notes/README.md"), s).expect("write readme");
+    }
+
+    /// The real Contents table is sorted by parsed version, and matches the
+    /// notes actually on disk.
+    #[test]
+    fn the_real_contents_table_is_sorted() {
+        let root = crate::workspace_root();
+        let n = check_notes_sorted(&root).expect("the real table is sorted and complete");
+        assert!(n >= 15, "expected at least 15 release notes, got {n}");
+    }
+
+    /// Parsed version order, not filename order: `1.10.0` sorts after `1.9.0`,
+    /// not between `1.1.0` and `1.2.0`.
+    #[test]
+    fn versions_sort_numerically_not_lexicographically() {
+        let dir = scratch("ucal-notes-sort-numeric");
+        for v in ["1.1.0", "1.2.0", "1.9.0", "1.10.0"] {
+            write_note(&dir, v);
+        }
+        let got = note_versions(&dir).expect("versions parse");
+        assert_eq!(got, vec!["1.10.0", "1.9.0", "1.2.0", "1.1.0"]);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// A Contents table listing the same versions out of order is refused.
+    #[test]
+    fn a_misordered_table_is_refused() {
+        let dir = scratch("ucal-notes-sort-misordered");
+        for v in ["1.0.0", "1.1.0", "1.10.0"] {
+            write_note(&dir, v);
+        }
+        // Filename-lexicographic order, not version order.
+        write_readme(&dir, &["1.1.0", "1.10.0", "1.0.0"]);
+        let e = check_notes_sorted(&dir).expect_err("the table is out of order");
+        assert!(
+            e.iter().any(|m| m.contains("not sorted")),
+            "expected the sort diagnostic, got: {e:?}"
+        );
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// A correctly sorted table over the same notes passes.
+    #[test]
+    fn a_correctly_sorted_table_is_accepted() {
+        let dir = scratch("ucal-notes-sort-ok");
+        for v in ["1.0.0", "1.1.0", "1.10.0"] {
+            write_note(&dir, v);
+        }
+        write_readme(&dir, &["1.10.0", "1.1.0", "1.0.0"]);
+        assert_eq!(check_notes_sorted(&dir), Ok(3));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// A note file with no row in the table is a mismatch, not a silent gap.
+    #[test]
+    fn a_note_missing_from_the_table_is_refused() {
+        let dir = scratch("ucal-notes-sort-missing-row");
+        for v in ["1.0.0", "1.1.0"] {
+            write_note(&dir, v);
+        }
+        write_readme(&dir, &["1.1.0"]);
+        let e = check_notes_sorted(&dir).expect_err("1.0.0 has no row");
+        assert!(e.iter().any(|m| m.contains("1.0.0")), "got: {e:?}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// A release-notes file not named for a semantic version is refused rather
+    /// than silently skipped.
+    #[test]
+    fn a_non_semver_filename_is_refused() {
+        let dir = scratch("ucal-notes-sort-bad-filename");
+        write_note(&dir, "1.0.0");
+        std::fs::write(
+            dir.join("Documentation/Release_Notes/notes.md"),
+            "not a version\n",
+        )
+        .expect("write");
+        let e = note_versions(&dir).expect_err("notes.md is not X.Y.Z");
+        assert!(e.contains("notes.md"), "got: {e}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}

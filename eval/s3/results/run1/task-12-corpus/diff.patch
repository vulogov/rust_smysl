+/// The inverse of [`ticks_in_nanos`]: whole nanoseconds in `t`, rounded down.
+///
+/// Only used to put a tick count sampled from a nanosecond-resolution clock
+/// back into the unit it came from for display — every input here arrived as
+/// an exact number of nanoseconds, so the division is exact and nothing is
+/// lost by rounding down.
+///
+/// Gated on `civil`: its one caller is `measured`'s `session_drift` field,
+/// which needs `wall_instant` to have a session clock to measure at all.
+#[cfg(feature = "civil")]
+fn nanos_in_ticks(t: &Ticks) -> Option<u128> {
+    let per_second = UC1::bridge().ticks;
+    let billion = <Ticks as TickInt>::from_u64(1_000_000_000);
+    let (per_nano, _) = per_second.quot_rem(&billion);
+    let (whole, _) = t.quot_rem(&per_nano);
+    whole.to_dec_string().parse().ok()
+}

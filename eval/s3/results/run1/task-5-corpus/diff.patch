@@ -0,0 +1,100 @@
+//! `smysl trace` with no uid: it walks the store's roots instead of refusing to run.
+//!
+//! `--roots` is how `view` and `pack --explain`'s implicit seed already spell "no uid was
+//! named, use what the store declares" (`smysl::view_roots`). `trace` had a required
+//! positional instead, so a caller who only had a store and wanted its provenance start had to
+//! find a root by hand first. Making the argument optional and falling back to `view_roots`
+//! makes `trace` consistent with that pattern rather than the odd one out.
+
+#![cfg(feature = "cli")]
+
+use std::process::Command;
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const F1: &str = "fixtures/corpus/F1-incident.smy";
+const F2: &str = "fixtures/corpus/F2-research.smy";
+const ROOT: &str = "b3:js4xzessu5zwjpv2rawtugnuvj";
+
+fn run(args: &[&str]) -> std::process::Output {
+    Command::new(BIN).args(args).output().unwrap()
+}
+
+/// F1 declares exactly one root (`f/root-cause`), so tracing with no uid must produce byte
+/// for byte the same output as tracing that root by name.
+#[test]
+fn no_uid_traces_the_stores_declared_root() {
+    let by_root = run(&["trace", ROOT, F1]);
+    let default = run(&["--store", F1, "trace"]);
+    assert!(
+        by_root.status.success(),
+        "{}",
+        String::from_utf8_lossy(&by_root.stderr)
+    );
+    assert!(
+        default.status.success(),
+        "{}",
+        String::from_utf8_lossy(&default.stderr)
+    );
+    assert_eq!(by_root.stdout, default.stdout);
+}
+
+/// A store with no declared view has no roots to fall back to, and that is a usage error,
+/// not an empty trace: an empty trace would look like "this unit has no ancestry" rather
+/// than "no unit was named".
+#[test]
+fn no_uid_and_no_declared_view_is_a_usage_error() {
+    let dir = std::env::temp_dir().join(format!("smysl-trace-noroot-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let f = dir.join("rootless.smy");
+    std::fs::write(
+        &f,
+        "@doc smysl/0.1 {\n  id: v/rootless\n}\n\n\
+         @evidence e/only { status: measured, source: { kind: metric, ref: \"m\" } }\n",
+    )
+    .unwrap();
+
+    let out = run(&["--store", f.to_str().unwrap(), "trace"]);
+    std::fs::remove_dir_all(&dir).ok();
+
+    assert_eq!(out.status.code(), Some(2), "{}", String::from_utf8_lossy(&out.stderr));
+    assert!(
+        String::from_utf8_lossy(&out.stderr).contains("no uid given"),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
+
+/// A store merged from two docs carries both their roots. Tracing with no uid walks from
+/// both at once rather than picking one arbitrarily.
+#[test]
+fn no_uid_walks_from_every_root_a_merged_store_declares() {
+    let dir = std::env::temp_dir().join(format!("smysl-trace-multiroot-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let merged = dir.join("merged.cbor");
+    let made = run(&["merge", F1, F2, "-o", merged.to_str().unwrap()]);
+    assert!(
+        made.status.success(),
+        "{}",
+        String::from_utf8_lossy(&made.stderr)
+    );
+
+    let out = run(&[
+        "--json",
+        "--store",
+        merged.to_str().unwrap(),
+        "trace",
+    ]);
+    std::fs::remove_dir_all(&dir).ok();
+
+    assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+    let stdout = String::from_utf8(out.stdout).unwrap();
+    let at = stdout.find("\"roots\":[").expect("the key is missing");
+    let list = &stdout[at..at + stdout[at..].find(']').unwrap() + 1];
+    assert_eq!(
+        list.matches("b3:").count(),
+        2,
+        "both docs' roots should be listed: {stdout}"
+    );
+    // Both roots are level-0 nodes of the same merged walk.
+    assert_eq!(stdout.matches("\"via\":\"root\"").count(), 2, "{stdout}");
+}

+/// The Contents table must list versions newest first, by *parsed* semantic
+/// version.
+///
+/// The table is hand-edited, and a version string sorts wrong as text: `1.9.0`
+/// reads after `1.10.0`, so a table kept in string order — or a row inserted by
+/// eye — silently misorders exactly where a two-digit component first appears.
+/// `check_ci_covers_the_procedure` hit the same defect from the other side and
+/// worked around it by deriving the version it needed rather than sorting; here
+/// the table's whole *point* is the order, so there is nothing to derive
+/// instead. Parsing each version into `(major, minor, patch)` before comparing
+/// is what makes the check agree with a reader who knows what `1.10.0 > 1.9.0`
+/// means, rather than with `str::cmp`.
+pub fn check_order(root: &Path) -> Result<usize, Vec<String>> {
+    let rows = rows(root).map_err(|e| vec![e])?;
+
+    let mut parsed = Vec::with_capacity(rows.len());
+    let mut bad = Vec::new();
+    for row in &rows {
+        match parse_version(&row.version) {
+            Some(v) => parsed.push((row.version.as_str(), v)),
+            None => bad.push(format!(
+                "`{}` in the Contents table is not a parseable `major.minor.patch`",
+                row.version
+            )),
+        }
+    }
+    if !bad.is_empty() {
+        return Err(bad);
+    }
+
+    for i in 1..parsed.len() {
+        let (av, a) = parsed[i - 1];
+        let (bv, b) = parsed[i];
+        if a <= b {
+            bad.push(format!(
+                "`{av}` is listed above `{bv}`, but {av} is not newer than {bv} as a \
+                 semantic version — the Contents table lists newest first"
+            ));
+        }
+    }
+    if bad.is_empty() {
+        Ok(parsed.len())
+    } else {
+        Err(bad)
+    }
+}

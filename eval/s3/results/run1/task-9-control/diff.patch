+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A scratch root with a Contents table made of exactly these rows, in
+    /// this order.
+    fn table(label: &str, rows: &[&str]) -> std::path::PathBuf {
+        let dir = std::env::temp_dir().join(format!("ucal-release-order-{label}"));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("Documentation/Release_Notes")).expect("mkdir");
+        let mut body = String::from("# Release notes\n\n## Contents\n\n| version | date | state |\n|---|---|---|\n");
+        for r in rows {
+            body.push_str(r);
+            body.push('\n');
+        }
+        std::fs::write(
+            dir.join("Documentation/Release_Notes/README.md"),
+            body,
+        )
+        .expect("write");
+        dir
+    }
+
+    /// `1.10.0` sorts before `1.2.0` as text and after it as a version. This is
+    /// the exact defect class `check_ci_covers_the_procedure` names in its own
+    /// history; here it must be *caught*, not worked around.
+    #[test]
+    fn a_two_digit_minor_out_of_numeric_order_is_caught() {
+        let dir = table(
+            "two-digit",
+            &[
+                "| [1.2.0](1.2.0.md) | 2026-08-08 | released |",
+                "| [1.10.0](1.10.0.md) | 2026-08-28 | released |",
+            ],
+        );
+        let e = check_order(&dir).expect_err("1.2.0 above 1.10.0 is out of numeric order");
+        assert!(e.iter().any(|m| m.contains("1.2.0") && m.contains("1.10.0")), "{e:?}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// Newest-first, correctly, is accepted.
+    #[test]
+    fn newest_first_is_accepted() {
+        let dir = table(
+            "ok",
+            &[
+                "| [1.10.0](1.10.0.md) | 2026-08-28 | released |",
+                "| [1.9.0](1.9.0.md) | 2026-08-27 | released |",
+                "| [1.1.0](1.1.0.md) | 2026-08-07 | released |",
+            ],
+        );
+        assert_eq!(check_order(&dir), Ok(3));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// A version string this project has never produced still has to be
+    /// reported, not silently skipped from the comparison.
+    #[test]
+    fn an_unparseable_version_is_reported_rather_than_skipped() {
+        let dir = table(
+            "bad-version",
+            &[
+                "| [1.9](1.9.md) | 2026-08-27 | released |",
+                "| [1.1.0](1.1.0.md) | 2026-08-07 | released |",
+            ],
+        );
+        let e = check_order(&dir).expect_err("`1.9` is not major.minor.patch");
+        assert!(e.iter().any(|m| m.contains("1.9")), "{e:?}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// This repository's own table, as it stands, is in order.
+    #[test]
+    fn the_real_contents_table_is_in_order() {
+        let root = crate::workspace_root();
+        assert!(check_order(&root).is_ok(), "{:?}", check_order(&root));
+    }
+}

+    // ---- capping how far one reading may advance ------------------------
+
+    /// A forward jump that outruns the cap is held to it for that reading.
+    #[test]
+    fn max_advance_caps_a_forward_jump() {
+        let mut s = Session::anchored_at(&at(100)).with_max_advance(ns(1_000_000_000));
+        let _ = s.reading(&at(100), &ns(0)).expect("a reading");
+        // The wall clock jumps ten seconds ahead between two readings taken
+        // ten milliseconds apart in real time — nowhere near enough elapsed
+        // time to justify the jump on its own.
+        let jumped = s
+            .reading(&at(110), &ns(10_000_000))
+            .expect("a reading");
+        assert_eq!(
+            jumped.ticks().to_dec_string(),
+            at(101).ticks().to_dec_string(),
+            "one reading advanced further than the cap allows"
+        );
+    }
+
+    /// The cap never refuses real elapsed time, only a wall correction that
+    /// outruns it.
+    #[test]
+    fn max_advance_never_holds_back_real_elapsed_time() {
+        let mut s = Session::anchored_at(&at(100)).with_max_advance(ns(1_000_000_000));
+        let _ = s.reading(&at(100), &ns(0)).expect("a reading");
+        // Five real seconds pass, and the wall clock agrees: the monotonic
+        // branch alone already clears the cap and must not be held to it.
+        let r = s
+            .reading(&at(105), &ns(5_000_000_000))
+            .expect("a reading");
+        assert_eq!(
+            r.ticks().to_dec_string(),
+            at(105).ticks().to_dec_string(),
+            "the cap held back a reading that real elapsed time justified"
+        );
+    }
+
+    /// A jump the cap cannot cover in one reading is caught up over several,
+    /// monotonically and without overshooting the wall clock's value.
+    #[test]
+    fn max_advance_smooths_a_jump_over_several_readings() {
+        let mut s = Session::anchored_at(&at(0)).with_max_advance(ns(1_000_000_000));
+        let mut prev = s.reading(&at(0), &ns(0)).expect("a reading").ticks().clone();
+        let target = at(10).ticks().clone();
+        // The wall clock jumps to ten seconds ahead and stays there; each
+        // call is only a millisecond of real elapsed time further on, so
+        // nothing but the cap explains any of this catching up.
+        for i in 1..=12u64 {
+            let elapsed = ns(u128::from(i) * 1_000_000);
+            let r = s.reading(&at(10), &elapsed).expect("a reading");
+            assert!(r.ticks() >= &prev, "step {i} went backwards");
+            assert!(r.ticks() <= &target, "step {i} overshot the wall clock");
+            prev = r.ticks().clone();
+        }
+        assert_eq!(
+            prev.to_dec_string(),
+            target.to_dec_string(),
+            "ten one-second-capped readings should have caught up to a ten second jump"
+        );
+    }

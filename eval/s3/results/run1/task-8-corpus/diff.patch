+/// How far one session-clock reading may advance past the last: one second's
+/// worth of ticks.
+///
+/// Generous next to how far a reading moves between two calls in the ordinary
+/// case — `ucal wallclock`'s fastest caller reads the clock twenty times a
+/// second, fifty milliseconds apart — so this only ever engages when the wall
+/// clock has stepped further than real elapsed time could explain, and a
+/// correction of any size is smoothed across at most that many readings
+/// rather than shown as a jump.
+#[cfg(all(feature = "std", feature = "civil"))]
+fn default_max_advance() -> Result<Ticks, TimeError> {
+    ticks_in_nanos(1_000_000_000).ok_or_else(|| TimeError::new(ucal_core::Code::E0021))
+}

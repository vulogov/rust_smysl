+/// A private copy of the `ephem residuals` fixture, unique per call.
+///
+/// Four synthetic observations: the predicted centres of cycles 0, 100, 250
+/// and 500 in `Documentation/examples/ephemeris.hjson`, moved by 0, +3, -7 and
+/// +41 seconds, so the residuals are known in advance and the arithmetic can
+/// be checked by eye.
+#[cfg(all(feature = "events", feature = "civil"))]
+mod observations {
+    const FIXTURE: &str = "\
+8070205175623907873429294080830071880530466139316558837890624
+8070205176188783324648635603786425480530466139316558837890624
+8070205177036096232523174090236455880530466139316558837890624
+8070205178448285611789196091997839880530466139316558837890624
+";
+
+    /// A file holding [`FIXTURE`], removed when this handle is dropped.
+    pub struct File(std::path::PathBuf);
+
+    impl File {
+        pub fn path(&self) -> &std::path::Path {
+            &self.0
+        }
+    }
+
+    impl Drop for File {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_file(&self.0);
+        }
+    }
+
+    /// Write the fixture under a name unique to this call.
+    ///
+    /// A process id alone is not enough: `commands()` is called from more than
+    /// one `#[test]` in this binary and those run concurrently, so calls
+    /// sharing a process id must still not share a file.
+    pub fn write() -> File {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static CALLS: AtomicU64 = AtomicU64::new(0);
+        let n = CALLS.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "ucal-json-surface-observations-{}-{n}.txt",
+            std::process::id()
+        ));
+        std::fs::write(&path, FIXTURE).expect("write observations fixture");
+        File(path)
+    }
+}

+    /// **A version bumped without its notes falls back to the newest notes that
+    /// do exist**, chosen numerically rather than by sorting filenames.
+    ///
+    /// A fresh cycle has no `Documentation/Release_Notes/<version>.md` yet — it
+    /// is written as part of opening the cycle — but CI's procedure still has to
+    /// be checked against *something*, and the newest completed cycle's notes
+    /// are the right answer.
+    ///
+    /// `1.9.0.md` and `1.10.0.md` are picked deliberately: sorting the two
+    /// filenames lexicographically puts `1.10.0.md` first, so the *last* one
+    /// sorted is `1.9.0.md` — the exact mistake `1.10.0`'s procedure check was
+    /// fixed for. Each file's verification block names a different command, so
+    /// which one the workflow actually has to run proves which file was read.
+    #[test]
+    fn a_missing_notes_file_falls_back_to_the_newest_by_version_not_by_sorting() {
+        let dir = std::env::temp_dir().join("ucal-procedure-fallback-to-newest");
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("Documentation/Release_Notes")).expect("mkdir");
+        std::fs::create_dir_all(dir.join(".github/workflows")).expect("mkdir");
+        std::fs::write(
+            dir.join("Cargo.toml"),
+            "[workspace.package]\nversion = \"9.9.9\"\n",
+        )
+        .expect("write");
+        std::fs::write(
+            dir.join("Documentation/Release_Notes/1.9.0.md"),
+            "## Verification\n\n```\ncargo check --workspace\n```\n",
+        )
+        .expect("write");
+        std::fs::write(
+            dir.join("Documentation/Release_Notes/1.10.0.md"),
+            "## Verification\n\n```\ncargo test --workspace\n```\n",
+        )
+        .expect("write");
+        // The workflow runs the command from `1.10.0.md`, the numerically newest
+        // — not `1.9.0.md`, which a lexicographic sort would have picked.
+        std::fs::write(
+            dir.join(".github/workflows/verify.yml"),
+            "jobs:\n  test:\n    run: cargo test --workspace\n",
+        )
+        .expect("write");
+
+        assert!(
+            super::check_ci_covers_the_procedure(&dir).is_ok(),
+            "should have fallen back to 1.10.0.md, the numerically newest notes"
+        );
+        let _ = std::fs::remove_dir_all(&dir);
+    }

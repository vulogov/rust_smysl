+/// A release-notes filename's version, as `(major, minor, patch)`.
+///
+/// `None` for anything that is not `N.N.N.md` — `README.md` lives in the same
+/// directory and is not a version.
+fn notes_file_version(name: &str) -> Option<(u64, u64, u64)> {
+    let stem = name.strip_suffix(".md")?;
+    let mut it = stem.split('.');
+    let v = (
+        it.next()?.parse().ok()?,
+        it.next()?.parse().ok()?,
+        it.next()?.parse().ok()?,
+    );
+    if it.next().is_some() {
+        return None;
+    }
+    Some(v)
+}
+
+/// The release notes for the highest version present in `dir`, compared
+/// numerically rather than by sorting filenames — sorting put `1.10.0.md`
+/// between `1.1.0.md` and `1.2.0.md`, which is the mistake this must not repeat.
+fn newest_notes_file(dir: &Path) -> Option<std::path::PathBuf> {
+    let entries = std::fs::read_dir(dir).ok()?;
+    entries
+        .flatten()
+        .filter_map(|e| {
+            let name = e.file_name();
+            let name = name.to_str()?;
+            Some((notes_file_version(name)?, e.path()))
+        })
+        .max_by_key(|(v, _)| *v)
+        .map(|(_, p)| p)
+}

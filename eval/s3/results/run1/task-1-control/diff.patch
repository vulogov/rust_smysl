@@ -378,3 +384,34 @@ fn write_rewrites_a_file_and_leaves_stdin_alone() {
 // that a document round-trips declaring the version it declared, and `tests/surface.rs`
 // asserts the records survive. If those ever fail, this guard is why `fmt` will refuse rather
 // than write the damage to disk.
+
+/// An already-canonical document takes the fast path: `fmt` still succeeds, still prints the
+/// same text it was given, and `--check` still agrees it needs no change — the observable
+/// behaviour is identical to before the reparse was skipped, only the work is smaller.
+#[test]
+fn an_already_canonical_file_skips_the_reparse_and_still_succeeds() {
+    let dir = scratch("already-canonical");
+    let canonical = dir.join("canonical.smy");
+
+    // `F1` round-tripped once, so the copy under test starts out canonical rather than
+    // relying on the fixture in the corpus never drifting.
+    let formatted = run(&["fmt", F1]);
+    assert_eq!(formatted.code, SUCCESS, "{}", formatted.stderr);
+    std::fs::write(&canonical, formatted.stdout.as_bytes()).expect("write canonical");
+    let p = canonical.to_str().unwrap();
+
+    let again = run(&["fmt", p]);
+    assert_eq!(again.code, SUCCESS, "{}", again.stderr);
+    assert_eq!(
+        again.stdout, formatted.stdout,
+        "formatting a canonical file must reproduce it exactly"
+    );
+
+    let check = run(&["fmt", "--check", p]);
+    assert_eq!(
+        check.code, SUCCESS,
+        "a canonical file must still pass --check: {}",
+        check.stderr
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}

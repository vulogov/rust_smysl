+/// Fix the session's anchor and monotonic base, if nothing has yet.
+///
+/// # Why at program start rather than on first use
+///
+/// A first draft anchored inside [`session_now`], on whichever call happened
+/// to come first. That reading is honest about *that* moment, but it is silent
+/// about everything the process did before it: argument parsing, a body file
+/// loaded, an ephemeris walked. If the wall clock stepped backwards during that
+/// stretch — the operator setting the date while `ucal` was already
+/// running — the anchor was taken *after* the step and never saw it, so the
+/// one guarantee this module sells, that a reading never goes backwards, held
+/// only from first use onward and not from the process's own beginning.
+///
+/// Calling this as close to `main`'s first line as the panic handler allows
+/// closes that gap: the anchor and the monotonic base are the process's, not
+/// whichever command's turn it was to ask first.
+///
+/// # Idempotent
+///
+/// The first call fixes both; every later call, including the one inside
+/// [`session_now`], leaves them alone. A binary that never calls this still
+/// gets the old behaviour — anchored lazily on first use — which is what every
+/// caller that only links the library, rather than running the `ucal` binary,
+/// still does.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn anchor_session() -> Result<(), TimeError> {
+    let wall = crate::wall_instant()?;
+    let mut g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    g.get_or_insert_with(|| (Session::anchored_at(&wall), std::time::Instant::now()));
+    Ok(())
+}
+

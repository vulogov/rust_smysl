+
+/// Pins the `formatted != src` branch on both sides: an already-canonical document takes the
+/// fast path that skips the reparse, and one `fmt` actually rewrites still goes through it.
+/// The behaviour is identical either way — only the parse count differs, which a black-box
+/// test cannot see — so what this pins is that neither path was accidentally dropped: both
+/// still exit `0` and still print the canonical text.
+#[test]
+fn an_already_canonical_document_takes_the_fast_path_and_a_changed_one_still_verifies() {
+    let dir = scratch("fast-path");
+    let body = "@claim c/a { status: speculative }\n~ a claim that stands alone\n";
+
+    // `formatted == src`: the reparse is skipped, and the output must equal the input.
+    let canonical = dir.join("canonical.smy");
+    std::fs::write(&canonical, body).expect("write");
+    let already = run(&["fmt", canonical.to_str().unwrap()]);
+    assert_eq!(already.code, SUCCESS, "{}", already.stderr);
+    assert_eq!(
+        already.stdout, body,
+        "an already-canonical file is unchanged by fmt"
+    );
+
+    // `formatted != src`: the reparse still runs, and must still succeed for a document
+    // `write_surface` actually rewrites.
+    let loose = dir.join("loose.smy");
+    std::fs::write(
+        &loose,
+        "@claim c/a {  status: speculative  }\n~ a claim with loose spacing\n",
+    )
+    .expect("write");
+    let changed = run(&["fmt", loose.to_str().unwrap()]);
+    assert_eq!(changed.code, SUCCESS, "{}", changed.stderr);
+    assert_ne!(
+        changed.stdout,
+        std::fs::read_to_string(&loose).unwrap(),
+        "a loosely-spaced file must actually be reformatted"
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}

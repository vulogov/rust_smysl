-    /// Where a project's ledger lives, relative to its root.
+    /// Where the ledger lives under the home directory, relative to it (§29, §7.3).
     pub const PATH: &'static str = ".smysl/usage.log";
 
+    /// The ledger's actual location: under the user's home directory rather than under any
+    /// one project, so usage accrues across every project `smysl` is run from instead of
+    /// resetting each time it is run from a different checkout. `None` when the home
+    /// directory cannot be resolved - the caller decides what to fall back to, because the
+    /// ledger is informational and must never be why a command fails (§23.1).
+    pub fn home_path() -> Option<PathBuf> {

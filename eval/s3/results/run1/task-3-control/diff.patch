@@ -630,4 +658,76 @@ mod tests {
     fn the_ledger_path_is_the_documented_one() {
         assert_eq!(Ledger::PATH, ".smysl/usage.log");
     }
+
+    // -- home directory --------------------------------------------------------
+
+    /// Restores whatever a test's environment variables held before it ran, so one test's
+    /// `SMYSL_HOME` can never leak into another's - including one running in parallel in the
+    /// same process, which is why this is a single test rather than several.
+    struct EnvGuard(Vec<(&'static str, Option<std::ffi::OsString>)>);
+
+    impl EnvGuard {
+        fn capture(vars: &[&'static str]) -> EnvGuard {
+            EnvGuard(vars.iter().map(|&v| (v, std::env::var_os(v))).collect())
+        }
+    }
+
+    impl Drop for EnvGuard {
+        fn drop(&mut self) {
+            for (k, prev) in &self.0 {
+                match prev {
+                    Some(v) => std::env::set_var(k, v),
+                    None => std::env::remove_var(k),
+                }
+            }
+        }
+    }
+
+    /// One test, not several: `home_dir` reads process-wide environment variables, and
+    /// separate `#[test]` functions run concurrently in the same process, so splitting this
+    /// into multiple tests would make them race on `SMYSL_HOME`/`HOME`/`USERPROFILE`.
+    #[test]
+    fn home_dir_resolution() {
+        let _g = EnvGuard::capture(&["SMYSL_HOME", "HOME", "USERPROFILE"]);
+
+        std::env::set_var("SMYSL_HOME", "/tmp/smysl-home-override");
+        std::env::set_var("HOME", "/tmp/should-not-be-used");
+        std::env::set_var("USERPROFILE", "/tmp/should-not-be-used-either");
+        assert_eq!(
+            home_dir(),
+            Some(PathBuf::from("/tmp/smysl-home-override")),
+            "an explicit SMYSL_HOME wins over both"
+        );
+        assert_eq!(
+            Ledger::home_path(),
+            Some(PathBuf::from("/tmp/smysl-home-override/.smysl/usage.log")),
+            "the ledger's home path is the home directory plus the documented relative path"
+        );
+
+        std::env::remove_var("SMYSL_HOME");
+        assert_eq!(
+            home_dir(),
+            Some(PathBuf::from("/tmp/should-not-be-used")),
+            "HOME wins over USERPROFILE once SMYSL_HOME is gone"
+        );
+
+        std::env::remove_var("HOME");
+        assert_eq!(
+            home_dir(),
+            Some(PathBuf::from("/tmp/should-not-be-used-either")),
+            "USERPROFILE is the last resort"
+        );
+
+        std::env::set_var("USERPROFILE", "");
+        assert_eq!(
+            home_dir(),
+            None,
+            "an empty value is treated the same as unset"
+        );
+        assert_eq!(
+            Ledger::home_path(),
+            None,
+            "with no home directory to resolve, there is no home path either"
+        );
+    }
 }

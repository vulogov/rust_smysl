+/// The user's home directory, or `None` if it cannot be resolved.
+///
+/// `$SMYSL_HOME` first — an explicit override, so the test suite (and an embedder that
+/// wants project-scoped isolation) never touches a real user's ledger — then `$HOME`, then
+/// `$USERPROFILE` for Windows. No dependency for this: three environment variables are the
+/// whole of what "home directory" means on every platform this builds for.
+pub fn home_dir() -> Option<PathBuf> {
+    ["SMYSL_HOME", "HOME", "USERPROFILE"]
+        .into_iter()
+        .find_map(|var| std::env::var_os(var).filter(|v| !v.is_empty()))
+        .map(PathBuf::from)
+}

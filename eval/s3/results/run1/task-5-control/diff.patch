diff --git a/tests/cmd_trace.rs b/tests/cmd_trace.rs
new file mode 100644
index 0000000..2bc4bb0
--- /dev/null
+++ b/tests/cmd_trace.rs
@@ -0,0 +1,155 @@
+//! `smysl trace` with no uid: it defaults to the store's roots (every root of every view)
+//! rather than refusing the invocation.
+//!
+//! Before this, `uid` was a required positional and a bare `smysl trace STORE` failed at the
+//! parser, before the command itself ran at all. The property worth pinning is that the
+//! default is not a special case with its own output shape - it is exactly what naming the
+//! roots by hand would have produced, byte for byte.
+
+#![cfg(feature = "cli")]
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+fn run(args: &[&str]) -> Out {
+    let o = Command::new(BIN)
+        .args(["--format", "surface"])
+        .args(args)
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-trace-{name}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+fn write(dir: &Path, name: &str, body: &str) -> PathBuf {
+    let p = dir.join(name);
+    std::fs::write(&p, body).expect("write document");
+    p
+}
+
+/// A single-rooted store: `c/root` grounds on `c/leaf`, and the view names `c/root` as its
+/// only root.
+fn single_root_store(dir: &Path) -> PathBuf {
+    write(
+        dir,
+        "store.smy",
+        "@doc smysl/1.0 {\n\
+         \x20 id: v/t\n\
+         \x20 roots: [c/root]\n\
+         }\n\
+         \n\
+         @claim c/leaf { status: speculative }\n\
+         ~ leaf claim\n\
+         \n\
+         @claim c/root { status: inferred, grounds: [c/leaf] }\n\
+         ~ root claim resting on leaf\n",
+    )
+}
+
+/// Omitting the uid produces exactly what naming the view's one root by hand produces.
+#[test]
+fn no_uid_traces_from_the_stores_one_root() {
+    let dir = scratch("single-root");
+    let store = single_root_store(&dir);
+    let store = store.to_str().unwrap();
+
+    let named = run(&["trace", "c/root", store]);
+    let defaulted = run(&["trace", store]);
+
+    assert!(named.code == 0, "stderr: {}", named.stderr);
+    assert_eq!(defaulted.code, named.code);
+    assert_eq!(defaulted.stdout, named.stdout);
+}
+
+/// A store with several view roots traces from all of them at once, not just the first.
+#[test]
+fn no_uid_traces_from_every_root_when_there_are_several() {
+    let dir = scratch("multi-root");
+    let store = write(
+        &dir,
+        "multi.smy",
+        "@doc smysl/1.0 {\n\
+         \x20 id: v/t\n\
+         \x20 roots: [c/root-a, c/root-b]\n\
+         }\n\
+         \n\
+         @claim c/root-a { status: speculative }\n\
+         ~ root a\n\
+         \n\
+         @claim c/root-b { status: speculative }\n\
+         ~ root b\n",
+    );
+    let store = store.to_str().unwrap();
+
+    let out = run(&["trace", store]);
+    assert_eq!(out.code, 0, "stderr: {}", out.stderr);
+    // Both roots walked, at depth 0, each as its own root - not one trace stapled after
+    // the other with a second, larger depth.
+    let root_lines = out.stdout.lines().filter(|l| l.ends_with("(root)")).count();
+    assert_eq!(root_lines, 2, "stdout: {}", out.stdout);
+    assert_eq!(out.stdout.lines().count(), 3, "stdout: {}", out.stdout);
+}
+
+/// No uid and no view at all is refused, not silently traced from nothing.
+#[test]
+fn no_uid_and_no_view_is_refused() {
+    let dir = scratch("no-view");
+    let store = write(
+        &dir,
+        "noview.smy",
+        "@claim c/only { status: speculative }\n~ nothing declares a view\n",
+    );
+    let store = store.to_str().unwrap();
+
+    let out = run(&["trace", store]);
+    assert_ne!(out.code, 0);
+    assert!(
+        out.stderr.contains("no uid given") && out.stderr.contains("no roots"),
+        "stderr: {}",
+        out.stderr
+    );
+}
+
+/// `--json` under the default is the same shape as under an explicit uid: a caller
+/// scripting against `trace` does not need to special-case "no argument given".
+#[test]
+fn no_uid_json_matches_named_root_json() {
+    let dir = scratch("json");
+    let store = single_root_store(&dir);
+    let store = store.to_str().unwrap();
+
+    let named = Command::new(BIN)
+        .args(["--json", "trace", "c/root", store])
+        .output()
+        .unwrap();
+    let defaulted = Command::new(BIN)
+        .args(["--json", "trace", store])
+        .output()
+        .unwrap();
+
+    assert!(named.status.success());
+    assert!(defaulted.status.success());
+    assert_eq!(named.stdout, defaulted.stdout);
+    assert!(
+        String::from_utf8_lossy(&defaulted.stdout).contains("\"nodes\":"),
+        "{}",
+        String::from_utf8_lossy(&defaulted.stdout)
+    );
+}

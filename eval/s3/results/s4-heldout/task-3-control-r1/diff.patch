diff --git a/tests/cmd_usage.rs b/tests/cmd_usage.rs
new file mode 100644
index 0000000..5863f23
--- /dev/null
+++ b/tests/cmd_usage.rs
@@ -0,0 +1,102 @@
+//! `smysl usage` reads the ledger in the user's home directory, not the project's.
+//!
+//! The ledger is where cost accumulates, and cost belongs to the person paying rather than to a
+//! checkout. Each test sets `HOME` to a directory of its own so none of them reads or writes the
+//! real one.
+
+#![cfg(all(feature = "cli", feature = "providers"))]
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+const LINE: &str = "{\"at\":1,\"provider\":\"ollama\",\"model\":\"m\",\"task\":\"attest\",\
+                    \"in\":30,\"out\":12,\"estimated\":false,\"retries\":0}\n";
+
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-usage-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+fn usage(cwd: &Path, home: Option<&Path>, args: &[&str]) -> (String, i32) {
+    let mut c = Command::new(BIN);
+    c.arg("usage")
+        .args(args)
+        .current_dir(cwd)
+        .env_remove("HOME")
+        .env_remove("USERPROFILE")
+        .stdin(Stdio::null());
+    if let Some(h) = home {
+        c.env("HOME", h);
+    }
+    let o = c.output().expect("the binary under test must run");
+    (
+        format!(
+            "{}{}",
+            String::from_utf8_lossy(&o.stdout),
+            String::from_utf8_lossy(&o.stderr)
+        ),
+        o.status.code().unwrap_or(-1),
+    )
+}
+
+fn write_ledger(dir: &Path) -> PathBuf {
+    let p = dir.join(".smysl/usage.log");
+    std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+    std::fs::write(&p, LINE).unwrap();
+    p
+}
+
+/// Two projects, one home, one ledger.
+#[test]
+fn every_project_reads_the_same_ledger() {
+    let home = scratch("home");
+    write_ledger(&home);
+    let (a, b) = (scratch("proj-a"), scratch("proj-b"));
+
+    for project in [&a, &b] {
+        let (out, code) = usage(project, Some(&home), &[]);
+        assert_eq!(code, 0, "{out}");
+        assert!(out.contains("ollama") && out.contains("1 call(s)"), "{out}");
+    }
+}
+
+/// A ledger left in the project by an earlier version is not read.
+#[test]
+fn a_project_ledger_is_not_the_ledger() {
+    let home = scratch("home-empty");
+    let project = scratch("proj-old");
+    write_ledger(&project);
+
+    let (out, code) = usage(&project, Some(&home), &[]);
+    assert_eq!(code, 0, "{out}");
+    assert!(out.contains("no model calls recorded"), "{out}");
+    assert!(
+        out.contains(home.to_str().unwrap()),
+        "it says where it looked: {out}"
+    );
+}
+
+#[test]
+fn reset_discards_the_home_ledger() {
+    let home = scratch("home-reset");
+    let path = write_ledger(&home);
+    let project = scratch("proj-reset");
+
+    let (out, code) = usage(&project, Some(&home), &["--reset"]);
+    assert_eq!(code, 0, "{out}");
+    assert!(out.contains("discarded 1 entr(ies)"), "{out}");
+    assert!(!path.exists());
+}
+
+#[test]
+fn no_home_is_a_failure_that_says_so() {
+    let project = scratch("proj-nohome");
+    let (out, code) = usage(&project, None, &[]);
+    assert_ne!(code, 0, "{out}");
+    assert!(out.contains("no home directory"), "{out}");
+    assert!(!project.join(".smysl").exists(), "nothing was written locally");
+}

+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn table(versions: &[&str]) -> String {
+        let mut t = String::from("| version | date | state |\n|---|---|---|\n");
+        for v in versions {
+            t.push_str(&format!("| [{v}]({v}.md) | 2026-08-01 | released |\n"));
+        }
+        t
+    }
+
+    fn order(text: &str) -> Vec<String> {
+        parse_rows(text)
+            .expect("rows")
+            .into_iter()
+            .map(|r| r.version)
+            .collect()
+    }
+
+    #[test]
+    fn versions_sort_numerically_not_as_text() {
+        // As strings: 0.1.1 < 0.1.10 < 0.1.2, and 1.10.0 < 1.12.0 < 1.9.0.
+        let got = order(&table(&["1.9.0", "1.10.0", "0.1.10", "1.12.0", "0.1.2", "0.1.1", "1.1.0"]));
+        assert_eq!(
+            got,
+            ["1.12.0", "1.10.0", "1.9.0", "1.1.0", "0.1.10", "0.1.2", "0.1.1"]
+        );
+    }
+
+    #[test]
+    fn an_already_sorted_table_is_unchanged() {
+        let v = ["1.12.0", "1.11.0", "1.10.0", "1.9.0", "0.1.0"];
+        assert_eq!(order(&table(&v)), v);
+    }
+
+    #[test]
+    fn a_version_that_does_not_parse_sorts_last_in_table_order() {
+        let got = order(&table(&["next", "0.1.0", "soon", "1.0.0"]));
+        assert_eq!(got, ["1.0.0", "0.1.0", "next", "soon"]);
+    }
+
+    #[test]
+    fn a_table_with_no_rows_is_still_an_error() {
+        assert!(parse_rows("| version | date | state |\n|---|---|---|\n").is_err());
+    }
+
+    #[test]
+    fn the_real_table_parses_newest_first() {
+        let rows = rows(&crate::workspace_root()).expect("the Contents table");
+        let parsed: Vec<_> = rows
+            .iter()
+            .map(|r| parse_version(&r.version).expect("a semantic version"))
+            .collect();
+        assert!(parsed.windows(2).all(|w| w[0] > w[1]), "{parsed:?}");
+    }
+}

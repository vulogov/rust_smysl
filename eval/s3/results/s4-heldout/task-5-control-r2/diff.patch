+//! `smysl trace` with no unit walks from the store's roots.
+//!
+//! The unit was required until 1.4, so asking "what does this store rest on" meant first finding
+//! the root's uid — which `view --roots` or the document header already says. The default is the
+//! same seed `salience` uses: every root of every view.
+//!
+//! Making the unit optional made the first positional ambiguous, since `trace STORE` has one
+//! argument and it is the store. Those cases are pinned here as well.
+
+#![cfg(feature = "cli")]
+
+use std::path::PathBuf;
+use std::process::{Command, Output};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const STORE: &str = "fixtures/corpus/F1-incident.smy";
+/// F1's declared root (`roots: [f/root-cause]`), and the uid it binds.
+const ROOT_LABEL: &str = "f/root-cause";
+
+fn run<S: AsRef<std::ffi::OsStr>>(args: &[S]) -> Output {
+    Command::new(BIN)
+        .args(["--format", "surface"])
+        .args(args)
+        .output()
+        .expect("the binary under test must run")
+}
+
+fn stdout(o: &Output) -> String {
+    String::from_utf8_lossy(&o.stdout).into_owned()
+}
+
+fn stderr(o: &Output) -> String {
+    String::from_utf8_lossy(&o.stderr).into_owned()
+}
+
+/// A scratch `.smy` file, named for the test that wants it.
+fn write(name: &str, body: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-trace-roots-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join(name);
+    std::fs::write(&path, body).unwrap();
+    path
+}
+
+#[test]
+fn no_unit_traces_from_the_declared_root() {
+    // Premise: F1 declares exactly one root. Otherwise the equality below could hold for the
+    // wrong reason.
+    let explicit = run(&["trace", ROOT_LABEL, STORE]);
+    assert!(explicit.status.success(), "{}", stderr(&explicit));
+
+    let default = run(&["trace", STORE]);
+    assert!(default.status.success(), "{}", stderr(&default));
+    assert_eq!(stdout(&default), stdout(&explicit));
+    assert!(stdout(&default).contains("6 unit(s) over 2 step(s)"));
+}
+
+#[test]
+fn the_default_takes_the_same_flags_and_the_global_store() {
+    for flags in [&["--parents"][..], &["--both"], &["--depth", "1"]] {
+        let mut with_root = vec!["trace"];
+        with_root.extend(flags);
+        let mut without = with_root.clone();
+        with_root.extend([ROOT_LABEL, STORE]);
+        without.push(STORE);
+        assert_eq!(
+            stdout(&run(&with_root)),
+            stdout(&run(&without)),
+            "{flags:?}"
+        );
+    }
+
+    let by_flag = run(&["--store", STORE, "trace"]);
+    assert!(by_flag.status.success(), "{}", stderr(&by_flag));
+    assert_eq!(stdout(&by_flag), stdout(&run(&["trace", STORE])));
+
+    let json = run(&["--json", "trace", STORE]);
+    assert!(stdout(&json).starts_with("{\"units\":6,\"steps\":2,\"nodes\":["));
+}
+
+#[test]
+fn a_named_unit_still_wins_over_the_roots() {
+    let out = run(&["trace", "c/pool-saturation", STORE]);
+    assert!(stdout(&out).contains("2 unit(s) over 1 step(s)"));
+}
+
+#[test]
+fn several_roots_are_walked_together_and_a_shared_unit_appears_once() {
+    let store = write(
+        "two-roots.smy",
+        "@doc smysl/0.1 {\n  id: v/two\n  intent: t\n  lang: en\n  granularity: { profile: default }\n  roots: [c/a, c/b]\n}\n\n\
+         @evidence e/shared { status: measured, source: { kind: metric, ref: \"m\", captured: 2026-07-22 } }\n~ Shared evidence.\n\n\
+         @claim c/a { status: inferred, grounds: [e/shared] }\n~ First.\n\n\
+         @claim c/b { status: inferred, grounds: [e/shared, c/a] }\n~ Second.\n",
+    );
+    let out = run(&["trace", store.to_str().unwrap()]);
+    assert!(out.status.success(), "{}", stderr(&out));
+    let text = stdout(&out);
+    // Two roots, and `c/a` is one of them even though `c/b` also reaches it a step down.
+    assert_eq!(text.matches("(root)").count(), 2, "{text}");
+    assert_eq!(text.matches("(grounds)").count(), 1, "{text}");
+    assert!(text.contains("3 unit(s) over 1 step(s)"), "{text}");
+}
+
+#[test]
+fn a_store_with_no_roots_says_so_rather_than_printing_nothing() {
+    let store = write(
+        "no-roots.smy",
+        "@doc smysl/0.1 {\n  id: v/none\n  intent: t\n  lang: en\n  granularity: { profile: default }\n}\n\n\
+         @claim c/a { status: asserted }\n~ Alone.\n",
+    );
+    let out = run(&["trace", store.to_str().unwrap()]);
+    assert_eq!(out.status.code(), Some(1), "{}", stderr(&out));
+    assert!(
+        stderr(&out).contains("declares no view roots"),
+        "{}",
+        stderr(&out)
+    );
+    assert!(stdout(&out).is_empty());
+}
+
+#[test]
+fn a_lone_argument_is_a_store_unless_it_reads_as_a_unit() {
+    // A unit with no store is still a usage error, as it was when the unit was required.
+    let uid = run(&["trace", "b3:cvhirtgs2mpvli2ethhyeo32uf"]);
+    assert_eq!(uid.status.code(), Some(2));
+    assert!(stderr(&uid).contains("no store given"));
+
+    let label = run(&["trace", "c/pool-saturation"]);
+    assert_eq!(label.status.code(), Some(2));
+    assert!(stderr(&label).contains("no store given"));
+
+    // A path that does not exist is reported as a path, not as a missing store.
+    let missing = run(&["trace", "no-such-store.smy"]);
+    assert_eq!(missing.status.code(), Some(1));
+    assert!(stderr(&missing).contains("no-such-store.smy"));
+}

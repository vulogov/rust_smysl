+/// A parsed semantic version, ordered by the rules of semver.org §11.
+///
+/// Build metadata is parsed and discarded: it has no precedence, so two
+/// versions differing only in it compare equal.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Version {
+    core: (u64, u64, u64),
+    pre: Vec<PreId>,
+}
+
+/// One dot-separated identifier of a pre-release. Numeric identifiers sort
+/// before alphanumeric ones, which the variant order gives for free.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+enum PreId {
+    Num(u64),
+    Text(String),
+}
+
+impl Ord for Version {
+    fn cmp(&self, other: &Self) -> Ordering {
+        self.core.cmp(&other.core).then_with(|| {
+            // A pre-release precedes the release it leads up to, and an empty
+            // list is that release; otherwise identifiers compare pairwise and
+            // the shorter list loses a tie, which is what `Vec`'s order is.
+            match (self.pre.is_empty(), other.pre.is_empty()) {
+                (true, true) => Ordering::Equal,
+                (true, false) => Ordering::Greater,
+                (false, true) => Ordering::Less,
+                (false, false) => self.pre.cmp(&other.pre),
+            }
+        })
+    }
+}
+
+impl PartialOrd for Version {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+/// `MAJOR.MINOR.PATCH[-pre][+build]`, or `None`.
+///
+/// Strict where semver is: three numeric components, none empty, none with a
+/// leading zero, so `1.10` and `01.2.3` are not versions.
+fn parse_version(v: &str) -> Option<Version> {
+    let v = v.split_once('+').map_or(v, |(core, build)| {
+        let ok = !build.is_empty()
+            && build
+                .split('.')
+                .all(|i| !i.is_empty() && i.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-'));
+        if ok {
+            core
+        } else {
+            // Not a valid build suffix; leave it in so that the parse fails.
+            v
+        }
+    });
+    let (core, pre) = match v.split_once('-') {
+        Some((core, pre)) => (core, Some(pre)),
+        None => (v, None),
+    };
+    let mut it = core.split('.');
+    let mut num = || {
+        let n = it.next()?;
+        if n.len() > 1 && n.starts_with('0') {
+            return None;
+        }
+        n.parse::<u64>().ok()
+    };
+    let core = (num()?, num()?, num()?);
+    if it.next().is_some() {
+        return None;
+    }
+    let mut ids = Vec::new();
+    if let Some(pre) = pre {
+        for i in pre.split('.') {
+            if i.is_empty() || !i.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-') {
+                return None;
+            }
+            if i.bytes().all(|b| b.is_ascii_digit()) {
+                if i.len() > 1 && i.starts_with('0') {
+                    return None;
+                }
+                ids.push(PreId::Num(i.parse().ok()?));
+            } else {
+                ids.push(PreId::Text(i.to_string()));
+            }
+        }
+    }
+    Some(Version { core, pre: ids })
+}
+
+/// Newest first; versions that do not parse after every one that does, in the
+/// order they were found. The sort is stable, so equal versions keep theirs.
+fn sort_newest_first(rows: &mut [Row]) {
+    rows.sort_by(|a, b| match (parse_version(&a.version), parse_version(&b.version)) {
+        (Some(a), Some(b)) => b.cmp(&a),
+        (Some(_), None) => Ordering::Less,
+        (None, Some(_)) => Ordering::Greater,
+        (None, None) => Ordering::Equal,
+    });
 }
 

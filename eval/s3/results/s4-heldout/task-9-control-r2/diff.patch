+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn row(v: &str) -> Row {
+        Row {
+            version: v.to_string(),
+            state: "released".to_string(),
+        }
+    }
+
+    fn sorted(versions: &[&str]) -> Vec<String> {
+        let mut r: Vec<Row> = versions.iter().map(|v| row(v)).collect();
+        sort_newest_first(&mut r);
+        r.into_iter().map(|r| r.version).collect()
+    }
+
+    /// **Versions order numerically, not as text.** As text `1.10.0` sits
+    /// between `1.1.0` and `1.2.0`.
+    #[test]
+    fn a_two_digit_minor_sorts_above_a_one_digit_one() {
+        assert_eq!(
+            sorted(&["1.2.0", "1.10.0", "1.1.0", "1.9.0", "0.8.0", "1.12.0", "1.11.0"]),
+            ["1.12.0", "1.11.0", "1.10.0", "1.9.0", "1.2.0", "1.1.0", "0.8.0"]
+        );
+        assert_eq!(sorted(&["1.0.9", "1.0.10", "1.0.2"]), ["1.0.10", "1.0.9", "1.0.2"]);
+        assert_eq!(sorted(&["9.0.0", "10.0.0"]), ["10.0.0", "9.0.0"]);
+    }
+
+    /// The table's own order is the ordering of the file, not of the versions.
+    #[test]
+    fn the_table_order_does_not_matter() {
+        let newest_first = ["1.12.0", "1.11.0", "1.10.0", "1.9.0", "0.1.1", "0.1.0"];
+        let mut shuffled = newest_first;
+        shuffled.reverse();
+        shuffled.swap(1, 4);
+        assert_eq!(sorted(&shuffled), newest_first);
+    }
+
+    #[test]
+    fn prereleases_precede_their_release_in_semver_order() {
+        assert_eq!(
+            sorted(&[
+                "1.0.0",
+                "1.0.0-rc.1",
+                "1.0.0-beta.11",
+                "1.0.0-beta.2",
+                "1.0.0-beta",
+                "1.0.0-alpha.1",
+                "1.0.0-alpha",
+                "1.0.0-1",
+            ]),
+            [
+                "1.0.0",
+                "1.0.0-rc.1",
+                "1.0.0-beta.11",
+                "1.0.0-beta.2",
+                "1.0.0-beta",
+                "1.0.0-alpha.1",
+                "1.0.0-alpha",
+                "1.0.0-1",
+            ]
+        );
+    }
+
+    #[test]
+    fn build_metadata_has_no_precedence() {
+        let a = parse_version("1.0.0+abc").expect("parses");
+        let b = parse_version("1.0.0+xyz").expect("parses");
+        assert_eq!(a.cmp(&b), Ordering::Equal);
+        assert_eq!(sorted(&["1.0.0+b", "1.0.0+a"]), ["1.0.0+b", "1.0.0+a"]);
+    }
+
+    #[test]
+    fn what_is_not_a_version_is_not_parsed_and_sorts_last() {
+        for bad in ["", "1", "1.2", "1.2.3.4", "01.2.3", "1.02.3", "1.2.x", "v1.2.3", "1.2.3-", "1.2.3-a..b", "1.2.3-01", "1.2.3+"] {
+            assert!(parse_version(bad).is_none(), "{bad:?} parsed");
+        }
+        assert_eq!(sorted(&["oops", "1.0.0", "next", "2.0.0"]), ["2.0.0", "1.0.0", "oops", "next"]);
+    }
+
+    #[test]
+    fn the_github_release_floor_compares_the_core() {
+        let v = |s: &str| parse_version(s).expect("parses").core;
+        assert!(v("1.0.0") >= GH_RELEASES_FROM);

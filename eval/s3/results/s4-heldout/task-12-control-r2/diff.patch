+/// How far the wall clock sits from the session clock's projection, and over
+/// what baseline.
+///
+/// The magnitude is unsigned (Rule B); [`wall_ahead`](Self::wall_ahead) is the
+/// sign.
+#[derive(Clone, Debug)]
+pub struct SessionDrift {
+    /// The distance between the wall clock and `anchor + monotonic_elapsed`.
+    pub ticks: Ticks,
+    /// `true` when the wall clock is ahead of the projection.
+    pub wall_ahead: bool,
+    /// Monotonic time since the session was anchored — the baseline the drift
+    /// was accumulated over.
+    pub since_anchor: Ticks,
+}
+
+/// The process-wide session's drift from the system clock, now.
+///
+/// `None` when nothing in this process has asked the time yet: the session is
+/// anchored on first use, so there is no anchor to drift from, and anchoring
+/// here would report a drift of zero over a baseline of zero and call it a
+/// measurement. A caller that wants a baseline anchors first with
+/// [`session_now`].
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn session_drift() -> Result<Option<SessionDrift>, TimeError> {
+    let wall = crate::wall_instant()?;
+    // Poisoning is survivable for the reason `session_now` gives.
+    let g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let Some((sess, base)) = g.as_ref() else {
+        return Ok(None);
+    };
+    let elapsed = ticks_in_nanos(base.elapsed().as_nanos())
+        .ok_or_else(|| TimeError::new(ucal_core::Code::E0021))?;
+    let (ticks, wall_ahead) = sess.divergence(&wall, &elapsed);
+    Ok(Some(SessionDrift {
+        ticks,
+        wall_ahead,
+        since_anchor: elapsed,
+    }))
+}
+
+/// Whole nanoseconds in `t` ticks, rounded toward zero.
+///
+/// Only for display: the exact tick count is reported beside it.
+pub fn nanos_in_ticks(t: &Ticks) -> Option<Ticks> {
+    let per_nano = ticks_in_nanos(1)?;
+    Some(t.quot_rem(&per_nano).0)
+}
+
+/// The report for a [`SessionDrift`], as fields for `doctor --clock`.
+pub fn drift_fields(d: Option<&SessionDrift>) -> Result<Vec<(String, Value)>, TimeError> {
+    let Some(d) = d else {
+        return Ok(vec![(
+            "session_drift".into(),
+            Value::text("not measured — no reading has anchored this process's session clock"),
+        )]);
+    };
+    let ns = |t: &Ticks| -> Result<String, TimeError> {
+        nanos_in_ticks(t)
+            .map(|n| n.to_dec_string())
+            .ok_or_else(|| TimeError::new(ucal_core::Code::E0021))
+    };
+    let magnitude = ns(&d.ticks)?;
+    let baseline = ns(&d.since_anchor)?;
+    let direction = if d.ticks.is_zero_ticks() {
+        "none observed"
+    } else if d.wall_ahead {
+        "the system clock is ahead of the session clock"
+    } else {
+        "the system clock is behind the session clock"
+    };
+    Ok(vec![
+        (
+            "session_drift".into(),
+            Value::text(format!(
+                "{magnitude} ns — {direction}, over {baseline} ns since the session \
+                 anchored. This is one process's lifetime, so it is mostly the two \
+                 clocks' quantisation and not a rate; it is not accuracy either, since \
+                 neither clock is compared with anything outside this machine"
+            )),
+        ),
+        ("session_drift_ticks".into(), Value::number(d.ticks.to_dec_string())),
+    ])
+}

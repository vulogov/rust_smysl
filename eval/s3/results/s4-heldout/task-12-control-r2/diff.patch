 // §19.3 — ucal doctor
 // ---------------------------------------------------------------------------
 
+/// `doctor --clock` says how far the session clock has drifted from the system
+/// clock, and the ordinary `doctor` does not: it is a measurement, and the
+/// ordinary output is compared byte for byte against a committed example.
+#[cfg(all(feature = "std", feature = "civil"))]
+#[test]
+fn doctor_clock_reports_session_drift() {
+    let measured = ucal::cmd_doctor_measuring().unwrap();
+    let Some(Value::Section(fields)) = measured.get("clock_measured") else {
+        panic!("no clock_measured section");
+    };
+    let keys: Vec<&str> = fields.iter().map(|(k, _)| k.as_str()).collect();
+    for want in ["session_drift", "session_drift_ticks"] {
+        assert!(keys.contains(&want), "clock_measured is missing `{want}`");
+    }
+    let drift = fields
+        .iter()
+        .find(|(k, _)| k == "session_drift")
+        .map(|(_, v)| v.rendered_text())
+        .unwrap();
+    assert!(!drift.starts_with("not measured"), "the session was not anchored: {drift}");
+
+    let plain = cmd_doctor().unwrap();
+    assert!(plain.get("clock_measured").is_none());
+}

+/// The release-notes file to check for `version`: its own notes when they
+/// exist, otherwise the newest notes in the directory.
+///
+/// "Newest" is by parsed `major.minor.patch`, not by filename — `1.10.0.md`
+/// sorts before `1.2.0.md` as text. Files that are not `<x>.<y>.<z>.md`
+/// (the README) are not notes. An error only when there are no notes at all.
+fn notes_file_for(root: &Path, version: &str) -> Result<std::path::PathBuf, String> {
+    let dir = root.join("Documentation/Release_Notes");
+    let own = dir.join(format!("{version}.md"));
+    if own.exists() {
+        return Ok(own);
+    }
+    let parse = |name: &str| -> Option<(u64, u64, u64)> {
+        let mut it = name.strip_suffix(".md")?.split('.');
+        let v = (
+            it.next()?.parse().ok()?,
+            it.next()?.parse().ok()?,
+            it.next()?.parse().ok()?,
+        );
+        it.next().is_none().then_some(v)
+    };
+    std::fs::read_dir(&dir)
+        .into_iter()
+        .flatten()
+        .flatten()
+        .filter_map(|e| {
+            let v = parse(e.file_name().to_str()?)?;
+            Some((v, e.path()))
+        })
+        .max()
+        .map(|(_, p)| p)
+        .ok_or_else(|| {
+            format!(
+                "the workspace is at {version} and {} has no notes to check, \
+                 neither for {version} nor any earlier version",
+                dir.display()
+            )
+        })
+}

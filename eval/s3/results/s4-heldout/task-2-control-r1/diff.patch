+//! `smysl check` with no path checks `.smysl/store`.
+//!
+//! It used to read stdin, which made a bare `smysl check` in a project hang on the terminal
+//! rather than check the project. Stdin is still there, but asked for as `-`.
+
+#![cfg(feature = "cli")]
+
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const F1: &str = "fixtures/corpus/F1-incident.smy";
+const F6: &str = "fixtures/corpus/F6-adversarial.smy";
+
+/// A scratch project directory holding `.smysl/store` copied from `fixture`.
+fn project(name: &str, fixture: &str) -> std::path::PathBuf {
+    let dir =
+        std::env::temp_dir().join(format!("smysl-check-default-{}-{name}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(dir.join(".smysl")).unwrap();
+    let src = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(fixture);
+    std::fs::copy(src, dir.join(".smysl/store")).unwrap();
+    dir
+}
+
+/// Run `smysl <args>` in `dir`, with stdin closed unless `stdin` is given.
+fn run_in(dir: &std::path::Path, args: &[&str], stdin: Option<&[u8]>) -> (i32, String, String) {
+    let mut child = Command::new(BIN)
+        .args(args)
+        .current_dir(dir)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("the binary under test must run");
+    let mut pipe = child.stdin.take().unwrap();
+    if let Some(bytes) = stdin {
+        pipe.write_all(bytes).unwrap();
+    }
+    drop(pipe);
+    let o = child.wait_with_output().unwrap();
+    (
+        o.status.code().unwrap_or(-1),
+        String::from_utf8_lossy(&o.stdout).into_owned(),
+        String::from_utf8_lossy(&o.stderr).into_owned(),
+    )
+}
+
+/// A clean store passes and a defective one fails, so the default is being *read*, not
+/// merely accepted: a `check` that ignored it and read the empty stdin would pass both.
+#[test]
+fn no_path_checks_the_default_store() {
+    let clean = project("clean", F1);
+    let (code, _, err) = run_in(&clean, &["check"], None);
+    assert_eq!(code, 0, "{err}");
+
+    let bad = project("bad", F6);
+    let (code, _, err) = run_in(&bad, &["check"], None);
+    assert_eq!(code, 3, "{err}");
+    assert!(
+        err.contains(".smysl/store"),
+        "diagnostics name the file: {err}"
+    );
+}
+
+/// No default store is a failure that names the path, not a silent pass over empty input.
+#[test]
+fn a_missing_default_store_is_reported() {
+    let dir =
+        std::env::temp_dir().join(format!("smysl-check-default-{}-empty", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let (code, _, err) = run_in(&dir, &["check"], None);
+    assert_ne!(code, 0);
+    assert!(err.contains(".smysl/store"), "{err}");
+}
+
+/// An explicit path or `--store` wins over the default, and `-` still reads stdin.
+#[test]
+fn explicit_arguments_override_the_default() {
+    let bad = project("override", F6);
+    let f1 = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(F1);
+
+    let (code, _, err) = run_in(&bad, &["check", f1.to_str().unwrap()], None);
+    assert_eq!(code, 0, "{err}");
+
+    let (code, _, err) = run_in(&bad, &["--store", f1.to_str().unwrap(), "check"], None);
+    assert_eq!(code, 0, "{err}");
+
+    let doc = std::fs::read(&f1).unwrap();
+    let (code, _, err) = run_in(&bad, &["check", "-"], Some(&doc));
+    assert_eq!(code, 0, "{err}");
+}

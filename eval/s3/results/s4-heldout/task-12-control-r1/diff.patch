+/// How far the system clock has moved from the session clock's projection, and
+/// over how long.
+///
+/// Where [`Session::divergence`] leaves off: this reads both clocks. The wall
+/// side is [`crate::wall_instant`], the raw reading, and not [`session_now`] —
+/// a session clock compared with its own output would report zero whatever the
+/// machine did, because `max` hands back whichever branch is ahead.
+///
+/// Anchors the session if nothing has, so a first call reports a baseline of
+/// nothing and a caller that wants a real one calls this early and again late.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn session_drift() -> Result<Drift, TimeError> {
+    let wall = crate::wall_instant()?;
+    let mut g = locked();
+    let (sess, base) = g.get_or_insert_with(|| {
+        (Session::anchored_at(&wall), std::time::Instant::now())
+    });
+    let (elapsed, baseline_ns) = since(base)?;
+    let (magnitude, wall_ahead) = sess.divergence(&wall, &elapsed);
+    Ok(Drift {
+        magnitude,
+        wall_ahead,
+        baseline_ns,
+    })
+}
+
+/// The system clock's distance from the session clock's projection.
+///
+/// A magnitude and a direction, because a tick count is unsigned (Rule B). It is
+/// a **difference between two clocks in one process**, not an error against the
+/// truth: the session's projection is the anchor plus the oscillator, and this
+/// is how far the system clock's disciplining has moved it away since.
+#[derive(Clone, Debug)]
+pub struct Drift {
+    /// How far apart the two are.
+    pub magnitude: Ticks,
+    /// Whether the system clock is ahead of the projection.
+    pub wall_ahead: bool,
+    /// Monotonic time since the session was anchored, in nanoseconds.
+    pub baseline_ns: u128,
+}
+
+impl Drift {
+    /// The sentence `doctor --clock` prints.
+    ///
+    /// The magnitude is a whole number of nanoseconds, since both readings are
+    /// placed to one; anything finer would be the conversion's and is dropped
+    /// by the division rather than shown.
+    pub fn describe(&self) -> String {
+        let per_ns = match ticks_in_nanos(1) {
+            Some(t) => t,
+            None => return "not representable".to_string(),
+        };
+        let (ns, _) = self.magnitude.quot_rem(&per_ns);
+        let ns = ns.to_dec_string();
+        let relation = if ns == "0" {
+            "the system clock agrees with"
+        } else if self.wall_ahead {
+            "the system clock is ahead of"
+        } else {
+            "the system clock is behind"
+        };
+        format!(
+            "{ns} ns over {} ns of monotonic time since the session was anchored — \
+             {relation} the session's projection. A difference between two clocks in \
+             this process, not an error against the truth; over a baseline this short \
+             it is mostly quantisation, and is not a rate",
+            self.baseline_ns
+        )
+    }
+}

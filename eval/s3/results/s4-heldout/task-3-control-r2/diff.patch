diff --git a/tests/cmd_usage.rs b/tests/cmd_usage.rs
new file mode 100644
index 0000000..9b5e8a3
--- /dev/null
+++ b/tests/cmd_usage.rs
@@ -0,0 +1,105 @@
+//! `smysl usage` reads one ledger per user, `~/.smysl/usage.log`, not one per project.
+//!
+//! The ledger was resolved against the store's directory, so a person running smysl in five
+//! checkouts had five ledgers and no way to ask what they had spent.
+
+#![cfg(all(feature = "cli", feature = "providers"))]
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+const ENTRY: &str = r#"{"at":1700,"provider":"ollama","model":"m","task":"attest","in":30,"out":12,"estimated":false,"retries":0}"#;
+
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-usage-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+fn usage(home: &Path, cwd: &Path, args: &[&str]) -> String {
+    let out = Command::new(BIN)
+        .arg("usage")
+        .args(args)
+        .env("HOME", home)
+        .env_remove("USERPROFILE")
+        .current_dir(cwd)
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).into_owned()
+}
+
+fn seed(home: &Path) -> PathBuf {
+    let ledger = home.join(".smysl/usage.log");
+    std::fs::create_dir_all(ledger.parent().unwrap()).unwrap();
+    std::fs::write(&ledger, format!("{ENTRY}\n")).unwrap();
+    ledger
+}
+
+#[test]
+fn the_ledger_is_read_from_the_home_directory() {
+    let root = scratch("read");
+    let (home, project) = (root.join("home"), root.join("project"));
+    std::fs::create_dir_all(&project).unwrap();
+    seed(&home);
+
+    let out = usage(&home, &project, &[]);
+    assert!(out.contains("ollama"), "{out}");
+    assert!(out.contains("42 tokens"), "{out}");
+}
+
+#[test]
+fn two_projects_see_the_same_ledger() {
+    let root = scratch("shared");
+    let home = root.join("home");
+    seed(&home);
+    for name in ["one", "two"] {
+        let project = root.join(name);
+        std::fs::create_dir_all(&project).unwrap();
+        assert!(usage(&home, &project, &[]).contains("42 tokens"), "{name}");
+    }
+}
+
+#[test]
+fn an_empty_ledger_names_the_home_path_and_leaves_the_project_alone() {
+    let root = scratch("empty");
+    let (home, project) = (root.join("home"), root.join("project"));
+    std::fs::create_dir_all(&project).unwrap();
+
+    let out = usage(&home, &project, &[]);
+    assert!(
+        out.contains(".smysl/usage.log: no model calls recorded"),
+        "{out}"
+    );
+    assert!(out.contains(home.to_str().unwrap()), "{out}");
+    assert!(!project.join(".smysl").exists());
+}
+
+#[test]
+fn a_project_local_ledger_is_no_longer_read() {
+    let root = scratch("local");
+    let (home, project) = (root.join("home"), root.join("project"));
+    std::fs::create_dir_all(&home).unwrap();
+    seed(&project);
+
+    assert!(usage(&home, &project, &[]).contains("no model calls recorded"));
+}
+
+#[test]
+fn reset_discards_the_home_ledger() {
+    let root = scratch("reset");
+    let (home, project) = (root.join("home"), root.join("project"));
+    std::fs::create_dir_all(&project).unwrap();
+    let ledger = seed(&home);
+
+    let out = usage(&home, &project, &["--reset"]);
+    assert!(out.contains("discarded 1"), "{out}");
+    assert!(!ledger.exists());
+}

+/// Walk from every one of `roots` at once: each unit once, at the least depth any root reaches it.
+///
+/// A root reached from another root is reported as a root, so the walk from a store's roots does
+/// not depend on which of them came first.
+fn trace_from(store: &Store, roots: &[Uid], kind: TraceKind, depth: Option<u32>) -> smysl::Lineage {
+    let mut lineages = roots.iter().map(|r| smysl::trace(store, *r, kind, depth));
+    let mut merged = lineages.next().expect("at least one root");
+    if roots.len() == 1 {
+        return merged;
+    }
+    let mut nodes = std::mem::take(&mut merged.nodes);
+    for l in lineages {
+        nodes.extend(l.nodes);
+    }
+    // Shallowest first, so the copy kept is the one nearest a root: a root that another root
+    // reaches is reported as a root, at depth 0, whichever of them came first.
+    nodes.sort_by_key(|n| (n.depth, n.uid));
+    let mut seen = std::collections::BTreeSet::new();
+    nodes.retain(|n| seen.insert(n.uid));
+    merged.nodes = nodes;
+    merged
+}

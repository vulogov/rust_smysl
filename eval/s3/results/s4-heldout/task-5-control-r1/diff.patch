+//! `smysl trace` without a unit walks from the store's roots.
+//!
+//! The unit was a required argument, so a caller who wanted "why does this document say what it
+//! says" first had to find the root — which the store already declares in its view. `salience`
+//! seeds itself from those roots when given none; `trace` now does the same.
+//!
+//! With the unit optional, `trace [UID] [PATH]` has two positionals and either may be absent. One
+//! positional is the store, as it is for every other command; that is what these tests pin down, along with the
+//! walk from several roots reporting each unit once.
+
+#![cfg(feature = "cli")]
+
+use std::process::Command;
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const F1: &str = "fixtures/corpus/F1-incident.smy";
+const ROOT: &str = "b3:js4xzessu5zwjpv2rawtugnuvj";
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+fn run(args: &[&str]) -> Out {
+    let o = Command::new(BIN)
+        .args(["--format", "surface"])
+        .args(args)
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+/// F1 with its `roots:` line replaced, in a directory of its own.
+fn f1_with_roots(name: &str, roots: Option<&str>) -> String {
+    let src = std::fs::read_to_string(F1).unwrap();
+    let line = "  roots: [f/root-cause]\n";
+    assert!(
+        src.contains(line),
+        "the fixture no longer declares its roots this way"
+    );
+    let replacement = roots
+        .map(|r| format!("  roots: [{r}]\n"))
+        .unwrap_or_default();
+    let dir = std::env::temp_dir().join(format!("smysl-trace-roots-{name}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("store.smy");
+    std::fs::write(&path, src.replace(line, &replacement)).unwrap();
+    path.to_str().unwrap().to_string()
+}
+
+#[test]
+fn no_unit_is_the_same_as_naming_the_root() {
+    // F1 declares one root, `f/root-cause`, and ROOT is its uid.
+    let named = run(&["trace", ROOT, F1]);
+    assert_eq!(named.code, 0, "{}", named.stderr);
+    let bare = run(&["trace", F1]);
+    assert_eq!(bare.code, 0, "{}", bare.stderr);
+    assert_eq!(bare.stdout, named.stdout);
+}
+
+#[test]
+fn the_walk_options_still_apply_to_the_default() {
+    let named = run(&["trace", "--depth", "1", "--both", ROOT, F1]);
+    let bare = run(&["trace", "--depth", "1", "--both", F1]);
+    assert_eq!(bare.code, 0, "{}", bare.stderr);
+    assert_eq!(bare.stdout, named.stdout);
+}
+
+#[test]
+fn several_roots_are_walked_together_and_each_unit_is_reported_once() {
+    // `c/canary-clean` is not reachable from `f/root-cause`, and `c/regression` is: as a second
+    // root it is reached at depth 1 by the first, and must be reported once, as a root.
+    let store = f1_with_roots(
+        "several",
+        Some("f/root-cause, c/canary-clean, c/regression"),
+    );
+    let out = run(&["trace", "--json", &store]);
+    assert_eq!(out.code, 0, "{}", out.stderr);
+    let v: serde_json::Value = serde_json::from_str(out.stdout.trim()).unwrap();
+    let nodes = v["nodes"].as_array().unwrap();
+
+    let uids: Vec<&str> = nodes.iter().map(|n| n["uid"].as_str().unwrap()).collect();
+    let mut unique = uids.clone();
+    unique.sort();
+    unique.dedup();
+    assert_eq!(
+        unique.len(),
+        uids.len(),
+        "a unit was reported twice: {uids:?}"
+    );
+    assert_eq!(v["units"], uids.len());
+
+    let roots = nodes.iter().filter(|n| n["via"] == "root").count();
+    assert_eq!(roots, 3, "{nodes:?}");
+    assert!(nodes
+        .iter()
+        .filter(|n| n["via"] == "root")
+        .all(|n| n["depth"] == 0));
+
+    // Everything the one-root walk reaches, plus the canary and its evidence.
+    let single = run(&["trace", "--json", ROOT, F1]);
+    let single: serde_json::Value = serde_json::from_str(single.stdout.trim()).unwrap();
+    assert_eq!(
+        v["units"].as_u64().unwrap(),
+        single["units"].as_u64().unwrap() + 2
+    );
+
+    // Deterministic: the same store, the same answer.
+    assert_eq!(run(&["trace", "--json", &store]).stdout, out.stdout);
+}
+
+#[test]
+fn a_store_with_no_roots_says_so_rather_than_printing_nothing() {
+    let store = f1_with_roots("none", None);
+    let out = run(&["trace", &store]);
+    assert_eq!(out.code, 2, "{}", out.stderr);
+    assert!(out.stdout.is_empty(), "{}", out.stdout);
+    assert!(out.stderr.contains("no unit given"), "{}", out.stderr);
+}
+
+#[test]
+fn a_bad_unit_is_still_refused_when_a_store_is_given() {
+    let out = run(&["trace", "c/pool-saturated", F1]);
+    assert_eq!(out.code, 1, "{}", out.stderr);
+    assert!(out
+        .stderr
+        .contains("is a label, and nothing in this store is bound to it"));
+}

+//! `smysl check` with no path checks `.smysl/store`.
+//!
+//! The default used to be standard input, which made a bare `smysl check` hang on a terminal
+//! and left a project with no way to say "check my store" without spelling out where it lives.
+//! Stdin is still there, but by asking for it with `-`.
+
+#![cfg(feature = "cli")]
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+const SUCCESS: i32 = 0;
+const FAILURE: i32 = 1;
+const CHECK_ERRORS: i32 = 3;
+
+/// The corpus documents are read, never written, so they are addressed from the manifest
+/// directory even though the binary runs from a scratch directory.
+const CLEAN: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/fixtures/corpus/F1-incident.smy");
+const BROKEN: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/fixtures/corpus/F6-adversarial.smy");
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+/// Run from `dir`, with `stdin` supplied when given and closed otherwise, so a regression
+/// to reading standard input ends in an empty store rather than a hung test.
+fn run_in(dir: &Path, args: &[&str], stdin: Option<&[u8]>) -> Out {
+    let mut child = Command::new(BIN)
+        .current_dir(dir)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("the binary under test must run");
+    let mut pipe = child.stdin.take().expect("piped stdin");
+    if let Some(bytes) = stdin {
+        pipe.write_all(bytes).expect("write stdin");
+    }
+    drop(pipe);
+    let o = child.wait_with_output().expect("wait");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+/// A project directory of this test's own, with `.smysl/store` holding a copy of `fixture`
+/// when one is given.
+fn project(name: &str, fixture: Option<&str>) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-check-default-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(dir.join(".smysl")).expect("project dir");
+    if let Some(f) = fixture {
+        std::fs::copy(f, dir.join(".smysl/store")).expect("copy fixture");
+    }
+    dir
+}
+
+#[test]
+fn no_path_checks_the_project_store() {
+    let dir = project("clean", Some(CLEAN));
+    let out = run_in(&dir, &["check"], None);
+    assert_eq!(out.code, SUCCESS, "stderr: {}", out.stderr);
+    assert!(
+        out.stdout.contains(".smysl/store"),
+        "the summary should name the store it read: {}",
+        out.stdout
+    );
+}
+
+#[test]
+fn no_path_reports_the_project_stores_errors() {
+    let dir = project("broken", Some(BROKEN));
+    let out = run_in(&dir, &["check"], None);
+    assert_eq!(out.code, CHECK_ERRORS, "stderr: {}", out.stderr);
+}
+
+/// The default store is not read *as well as* standard input, and input on stdin does not
+/// override it: what is piped in here is broken, what is on disk is clean.
+#[test]
+fn no_path_ignores_stdin() {
+    let dir = project("ignores-stdin", Some(CLEAN));
+    let broken = std::fs::read(BROKEN).expect("read fixture");
+    let out = run_in(&dir, &["check"], Some(&broken));
+    assert_eq!(out.code, SUCCESS, "stderr: {}", out.stderr);
+}
+
+#[test]
+fn a_dash_still_reads_stdin() {
+    let dir = project("dash", Some(CLEAN));
+    let broken = std::fs::read(BROKEN).expect("read fixture");
+    let out = run_in(&dir, &["check", "-"], Some(&broken));
+    assert_eq!(out.code, CHECK_ERRORS, "stderr: {}", out.stderr);
+}
+
+#[test]
+fn an_explicit_path_wins_over_the_default() {
+    let dir = project("explicit", Some(BROKEN));
+    let out = run_in(&dir, &["check", CLEAN], None);
+    assert_eq!(out.code, SUCCESS, "stderr: {}", out.stderr);
+}
+
+#[test]
+fn the_store_flag_wins_over_the_default() {
+    let dir = project("flag", Some(BROKEN));
+    let out = run_in(&dir, &["--store", CLEAN, "check"], None);
+    assert_eq!(out.code, SUCCESS, "stderr: {}", out.stderr);
+}
+
+#[test]
+fn a_missing_default_store_is_a_failure_that_names_it() {
+    let dir = project("missing", None);
+    let out = run_in(&dir, &["check"], None);
+    assert_eq!(out.code, FAILURE, "stdout: {}", out.stdout);
+    assert!(
+        out.stderr.contains(".smysl/store"),
+        "the error should name the path it looked for: {}",
+        out.stderr
+    );
+}

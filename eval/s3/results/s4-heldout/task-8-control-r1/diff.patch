+/// Cap how far one reading of the live clock may advance, from `--max-advance`.
+///
+/// Smooths a forward step of the system clock into a run of steps this size
+/// rather than one jump on the face. Refused under
+/// [`clock::MIN_MAX_ADVANCE_NANOS`](crate::clock::MIN_MAX_ADVANCE_NANOS): the
+/// clock is redrawn every [`REFRESH`], and a cap smaller than the gap between
+/// readings makes the clock run slow instead of smoothing anything.
+pub fn set_max_advance(span: &str) -> Result<(), TimeError> {
+    use ucal_core::Code;
+    let nanos = crate::clock::parse_span_nanos(span)?;
+    if nanos < crate::clock::MIN_MAX_ADVANCE_NANOS {
+        return Err(TimeError::with_context(
+            Code::E0018,
+            "--max-advance under 100ms is below twice the refresh interval, so \
+             the clock would run slow rather than smooth a jump",
+        ));
+    }
+    let cap = crate::clock::ticks_in_nanos(nanos).ok_or_else(|| TimeError::new(Code::E0021))?;
+    crate::clock::set_max_advance(Some(cap))
+}

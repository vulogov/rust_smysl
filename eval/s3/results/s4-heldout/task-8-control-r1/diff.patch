+/// Parse a span for `--max-advance`: an integer and a unit, `500ms`, `2s`.
+///
+/// Units are `ns`, `us`, `ms`, `s`, `m`. A bare number is refused rather than
+/// guessed at — `--max-advance 5` would be seconds to one reader and
+/// milliseconds to another.
+pub fn parse_span_nanos(s: &str) -> Result<u128, TimeError> {
+    let bad = || {
+        TimeError::with_context(
+            ucal_core::Code::E0001,
+            "expected a whole number and a unit — ns, us, ms, s or m — like `500ms` or `2s`",
+        )
+    };
+    let t = s.trim();
+    let split = t.find(|c: char| !c.is_ascii_digit()).ok_or_else(bad)?;
+    let (digits, unit) = t.split_at(split);
+    let n: u128 = digits.parse().map_err(|_| bad())?;
+    let per: u128 = match unit {
+        "ns" => 1,
+        "us" => 1_000,
+        "ms" => 1_000_000,
+        "s" => 1_000_000_000,
+        "m" => 60_000_000_000,
+        _ => return Err(bad()),
+    };
+    n.checked_mul(per).ok_or_else(bad)
+}

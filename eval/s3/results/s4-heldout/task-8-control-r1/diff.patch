+    /// **The cap.** A forward step is taken as a run of steps no larger than the
+    /// cap, and the reading ends on the wall clock.
+    #[test]
+    fn a_capped_session_smooths_a_forward_jump() {
+        let mut s = Session::anchored_at(&at(100)).with_max_advance(Some(ns(2_000_000_000)));
+        // The wall clock leaps an hour in one second of monotonic time.
+        let mut prev = s.reading(&at(101), &ns(1_000_000_000)).expect("a reading");
+        assert_eq!(prev.ticks().to_dec_string(), at(101).ticks().to_dec_string());
+        let target = at(3_701);
+        let mut steps = 0u32;
+        loop {
+            let r = s.reading(&target, &ns(2_000_000_000)).expect("a reading");
+            let moved = r.ticks().try_sub(prev.ticks()).expect("monotone");
+            assert!(
+                moved <= ns(2_000_000_000),
+                "a reading advanced {} ticks, past the cap",
+                moved.to_dec_string()
+            );
+            prev = r;
+            steps += 1;
+            if prev.ticks() >= target.ticks() {
+                break;
+            }
+            assert!(steps < 5_000, "the reading never reached the wall clock");
+        }
+        assert_eq!(prev.ticks().to_dec_string(), target.ticks().to_dec_string());
+        // 3600 s in 2 s steps, the last of which lands exactly.
+        assert_eq!(steps, 1_800);
+    }
+

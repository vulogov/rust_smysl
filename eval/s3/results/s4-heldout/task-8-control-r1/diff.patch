+/// Bound how far one reading of the process-wide session may advance.
+///
+/// Anchors the session now if nothing has read the clock yet, so the cap is in
+/// force from the first reading. `None` lifts it.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn set_max_advance(cap: Option<Ticks>) -> Result<(), TimeError> {
+    let wall = crate::wall_instant()?;
+    let mut g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let (sess, _) = g.get_or_insert_with(|| {
+        (Session::anchored_at(&wall), std::time::Instant::now())
+    });
+    *sess = sess.clone().with_max_advance(cap);
+    Ok(())
+}

+/// `--max-advance` smooths a live clock; on a single frame it is a mistake, and
+/// a bad or too-small span is refused before the terminal is taken over.
+#[test]
+fn max_advance_is_refused_where_it_means_nothing() {
+    let (code, err) = ucal(&["wallclock", "--once", "--max-advance", "1s"]);
+    assert_ne!(code, 0, "accepted with --once");
+    assert!(err.contains("--max-advance"), "{err}");
+
+    let (code, err) = ucal(&["--json", "wallclock", "--once", "--max-advance", "1s"]);
+    assert_ne!(code, 0, "accepted with --json");
+    assert!(err.contains("--max-advance"), "{err}");
+
+    let (code, err) = ucal(&["wallclock", "--max-advance", "10ms"]);
+    assert_ne!(code, 0, "a cap under the refresh interval was accepted");
+    assert!(err.contains("100ms"), "{err}");
+
+    let (code, _) = ucal(&["wallclock", "--max-advance", "1"]);
+    assert_ne!(code, 0, "a bare number was accepted");
+}

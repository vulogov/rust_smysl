+fn ucal(args: &[&str]) -> (i32, String) {
+    let mut p = std::env::current_exe().expect("test binary path");
+    p.pop();
+    if p.ends_with("deps") {
+        p.pop();
+    }
+    let out = std::process::Command::new(p.join(format!("ucal{}", std::env::consts::EXE_SUFFIX)))
+        .args(args)
+        .env("NO_COLOR", "1")
+        .output()
+        .expect("run ucal");
+    (
+        out.status.code().unwrap_or(-1),
+        String::from_utf8_lossy(&out.stderr).into_owned(),
+    )
+}

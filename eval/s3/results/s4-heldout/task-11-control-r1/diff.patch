+//! Shared by the test binaries that run `ephem residuals`.
+
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+/// Four synthetic observed instants: the predicted centres of cycles 0, 100,
+/// 250 and 500 of `Documentation/examples/ephemeris.hjson`, moved by 0, +3, -7
+/// and +41 seconds. The residuals are known in advance.
+const OBSERVATIONS: &str = "\
+# cycle 0, +0 s
+8070205175623907873429294080830071880530466139316558837890624
+# cycle 100, +3 s
+8070205176188783324648635603786425480530466139316558837890624
+# cycle 250, -7 s
+8070205177036096232523174090236455880530466139316558837890624
+# cycle 500, +41 s
+8070205178448285611789196091997839880530466139316558837890624
+";
+
+/// Write the observations to a file of their own and return its path.
+///
+/// The first version wrote them into `std::env::temp_dir()` under one fixed
+/// name, from two test binaries that run concurrently. One truncated the file
+/// while the other read it, and the residuals run read nothing. The name now
+/// carries the process id and a counter, so no two calls — in one binary or
+/// across binaries — share a path, and every caller reads what it wrote.
+///
+/// The files are left behind, in Cargo's per-target scratch directory.
+#[allow(dead_code)]
+pub fn write_observations() -> PathBuf {
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    let n = NEXT.fetch_add(1, Ordering::Relaxed);
+    let path = PathBuf::from(env!("CARGO_TARGET_TMPDIR"))
+        .join(format!("observations-{}-{n}.txt", std::process::id()));
+    std::fs::write(&path, OBSERVATIONS).expect("write the observations fixture");
+    path
+}

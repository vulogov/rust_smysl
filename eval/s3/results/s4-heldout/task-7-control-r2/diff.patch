+    /// **Anchored at start, not at the first reading.** A wall clock that steps
+    /// back between the two does not become the anchor.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn the_anchor_is_taken_at_start_and_not_at_the_first_reading() {
+        let state: SessionState = std::sync::Mutex::new(None);
+        anchor_in(&state, &at(100)).expect("anchored");
+        assert!(state.lock().expect("lock").is_some(), "start anchored nothing");
+        // The wall clock is now behind where it started. Had the first reading
+        // anchored, this would come back as `at(50)`.
+        let r = read_in(&state, &at(50)).expect("a reading");
+        assert!(
+            r.ticks() >= at(100).ticks(),
+            "the first reading re-anchored the session: {}",
+            r.ticks().to_dec_string()
+        );
+    }
+
+    /// Anchoring twice keeps the first anchor.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn a_second_anchor_does_not_replace_the_first() {
+        let state: SessionState = std::sync::Mutex::new(None);
+        anchor_in(&state, &at(100)).expect("anchored");
+        anchor_in(&state, &at(500)).expect("anchored");
+        let g = state.lock().expect("lock");
+        let (sess, _) = g.as_ref().expect("anchored");
+        assert_eq!(sess.anchor.to_dec_string(), at(100).ticks().to_dec_string());
+    }
+
+    /// `start` anchors the process-wide session, and readings keep working.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn start_anchors_the_process_session() {
+        start();
+        assert!(session().lock().expect("lock").is_some());
+        session_now().expect("a reading");
+    }

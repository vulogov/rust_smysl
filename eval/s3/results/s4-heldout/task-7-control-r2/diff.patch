+/// Anchor the process-wide session now, if it is not anchored already.
+///
+/// Called first thing in `main`, so the session's anchor and its monotonic base
+/// are both taken at program start rather than at whichever reading happens to
+/// come first. `ucal wallclock` can spend a while parsing arguments and setting
+/// up a terminal before it asks the time, and a backward step in that window
+/// would otherwise be the anchor.
+///
+/// Best effort, and silent: a system clock that cannot be read here — it
+/// precedes the Unix epoch — is the same failure [`session_now`] reports to a
+/// command that asks for the time, and a command that does not ask should not
+/// fail for it. A failed start leaves the session unanchored, and the first
+/// reading anchors it as it always did.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn start() {
+    if let Ok(wall) = crate::wall_instant() {
+        let _ = anchor_in(session(), &wall);
+    }
+}
+
 /// The session clock's reading, for [`crate::now_instant`].
 #[cfg(all(feature = "std", feature = "civil"))]
 pub fn session_now() -> Result<Instant<UC1>, TimeError> {
     let wall = crate::wall_instant()?;
+    read_in(session(), &wall)
+}
+
+/// Anchor `state` at `wall` unless it is anchored, and take a reading.
+///
+/// Anchored on the first call of either kind: [`start`] does it at program
+/// start, and a reading does it if nothing has.
+#[cfg(all(feature = "std", feature = "civil"))]
+fn read_in(state: &SessionState, wall: &Instant<UC1>) -> Result<Instant<UC1>, TimeError> {
     // A poisoned lock means another thread panicked holding it. The state is a
     // pair of tick counts and cannot be torn, so taking the inner value is
     // correct rather than merely convenient — the same judgement
     // `body_file::leak` makes about its intern pool.
-    let mut g = match session().lock() {
+    let mut g = match state.lock() {
         Ok(g) => g,
         Err(poisoned) => poisoned.into_inner(),
     };
-    // Anchored on first use rather than at start-up: a command that never asks
-    // the time should not read a clock, and most of them do not.
     let (sess, base) = g.get_or_insert_with(|| {
-        (Session::anchored_at(&wall), std::time::Instant::now())
+        (Session::anchored_at(wall), std::time::Instant::now())
     });
     let elapsed = ticks_in_nanos(base.elapsed().as_nanos())
         .ok_or_else(|| TimeError::new(ucal_core::Code::E0021))?;
-    sess.reading(&wall, &elapsed)
+    sess.reading(wall, &elapsed)
+}
+
+/// [`read_in`], for the call that only wants the anchor.
+#[cfg(all(feature = "std", feature = "civil"))]
+fn anchor_in(state: &SessionState, wall: &Instant<UC1>) -> Result<Instant<UC1>, TimeError> {
+    read_in(state, wall)
 }
 

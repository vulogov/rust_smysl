+//! Helpers shared by the integration tests that need a file on disk.
+
+use std::path::PathBuf;
+
+/// Four synthetic observations for `Documentation/examples/ephemeris.hjson`:
+/// the predicted centres of cycles 0, 100, 250 and 500, moved by 0, +3, −7 and
+/// +41 seconds. The residuals are known in advance, and the last is outside its
+/// own window while the others are not.
+const OBSERVATIONS: &str = "\
+# cycle 0, +0 s
+8070205175623907873429294080830071880530466139316558837890624
+# cycle 100, +3 s
+8070205176188783324648635603786425480530466139316558837890624
+# cycle 250, -7 s
+8070205177036096232523174090236455880530466139316558837890624
+# cycle 500, +41 s
+8070205178448285611789196091997839880530466139316558837890624
+";
+
+/// An observations file, written for this test and removed on drop.
+///
+/// The path is unique to the process and to `label`. A fixed name in the shared
+/// temp directory was written by two test binaries at once, one truncating the
+/// file while the other read it, and a residuals run read nothing.
+pub struct Observations(PathBuf);
+
+impl Observations {
+    pub fn write(label: &str) -> Self {
+        let path = PathBuf::from(env!("CARGO_TARGET_TMPDIR"))
+            .join(format!("observations-{label}-{}.txt", std::process::id()));
+        std::fs::write(&path, OBSERVATIONS).expect("write observations");
+        Observations(path)
+    }
+
+    pub fn path(&self) -> &str {
+        self.0.to_str().expect("utf-8 path")
+    }
+}
+
+impl Drop for Observations {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}

+/// `major.minor.patch` from a notes filename such as `1.10.0.md`.
+fn notes_version(name: &str) -> Option<(u64, u64, u64)> {
+    let mut it = name.strip_suffix(".md")?.split('.');
+    let v = (
+        it.next()?.parse().ok()?,
+        it.next()?.parse().ok()?,
+        it.next()?.parse().ok()?,
+    );
+    it.next().is_none().then_some(v)
+}
+
+/// The notes file for `version`, or the newest by version number if that one
+/// does not exist. `None` when there are no versioned notes at all.
+fn notes_for(root: &Path, version: &str) -> Option<std::path::PathBuf> {
+    let dir = root.join("Documentation/Release_Notes");
+    let current = dir.join(format!("{version}.md"));
+    if current.exists() {
+        return Some(current);
+    }
+    std::fs::read_dir(&dir)
+        .ok()?
+        .flatten()
+        .filter_map(|e| {
+            let v = notes_version(e.file_name().to_str()?)?;
+            Some((v, e.path()))
+        })
+        .max()
+        .map(|(_, p)| p)
+}

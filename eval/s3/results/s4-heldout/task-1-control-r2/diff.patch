+/// A document already in canonical form skips the round-trip re-parse, because parsing the
+/// writer's output is parsing the input again. Skipping must change nothing a user can see:
+/// `--check` passes, `--write` leaves the bytes alone, and plain `fmt` prints the input.
+#[test]
+fn an_already_canonical_file_is_unchanged_by_every_mode() {
+    let dir = scratch("canonical");
+    let loose = dir.join("loose.smy");
+    std::fs::write(
+        &loose,
+        "@claim c/a {  status: speculative  }\n~ a claim with loose spacing\n",
+    )
+    .expect("write");
+    let canonical_text = run(&["fmt", loose.to_str().unwrap()]).stdout;
+    assert!(!canonical_text.is_empty());
+
+    let canonical = dir.join("canonical.smy");
+    std::fs::write(&canonical, &canonical_text).expect("write");
+    let c = canonical.to_str().unwrap();
+
+    let printed = run(&["fmt", c]);
+    assert_eq!(printed.code, SUCCESS, "{}", printed.stderr);
+    assert_eq!(printed.stdout, canonical_text, "fmt prints the input back");
+
+    let checked = run(&["fmt", "--check", c]);
+    assert_eq!(checked.code, SUCCESS, "{}", checked.stderr);
+    assert!(!checked.stderr.contains("does not reproduce"));
+
+    let written = run(&["fmt", "--write", c]);
+    assert_eq!(written.code, SUCCESS, "{}", written.stderr);
+    assert_eq!(std::fs::read_to_string(&canonical).unwrap(), canonical_text);
+    let _ = std::fs::remove_dir_all(&dir);
+}

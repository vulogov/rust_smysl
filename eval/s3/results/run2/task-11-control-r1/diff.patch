+/// A freshly written observations file, removed when dropped.
+///
+/// O1 — residuals used to read from a fixture **committed** at
+/// `Documentation/examples/observations.txt`. Before that, the first version
+/// wrote one into `std::env::temp_dir()` under a fixed name, and this file and
+/// `manual_fields.rs` both did it — two test binaries, one path, run
+/// concurrently. One truncated the file while the other read it, which
+/// produced a residuals run that had read nothing. It passed locally every
+/// time and failed in CI on the cut commit.
+///
+/// This writes one again, keyed on the process id *and* the thread id: `id`
+/// alone repeats the original bug, because `commands()` is called from several
+/// tests below and they run on separate threads of the same process.
+#[cfg(all(feature = "events", feature = "civil"))]
+struct ObsFile(std::path::PathBuf);
+#[cfg(all(feature = "events", feature = "civil"))]
+impl ObsFile {
+    fn write() -> ObsFile {
+        let mut p = std::env::temp_dir();
+        p.push(format!(
+            "ucal-json-surface-observations-{}-{:?}.txt",
+            std::process::id(),
+            std::thread::current().id()
+        ));
+        std::fs::write(&p, SYNTHETIC_OBSERVATIONS).expect("write synthetic observations");
+        ObsFile(p)
+    }
+}
+#[cfg(all(feature = "events", feature = "civil"))]
+impl Drop for ObsFile {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}

+//! `smysl check` with no path, driven as a user drives it.
+//!
+//! Every other command that takes a store falls back to stdin when given neither a positional
+//! path nor `--store` (rule P). `check` is the exception: a bare `check` is a habit run
+//! repeatedly inside a project checkout, not a pipeline stage, so it looks at `.smysl/store`
+//! instead of blocking on a terminal that never sends EOF.
+
+#![cfg(feature = "cli")]
+
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+fn run_in(dir: &std::path::Path, args: &[&str]) -> Out {
+    let o = Command::new(BIN)
+        .args(args)
+        .current_dir(dir)
+        .stdin(Stdio::null())
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+fn scratch(name: &str) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-check-{name}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+const SUCCESS: i32 = 0;
+const FAILURE: i32 = 1;
+const A_CLAIM: &str = "@claim c/a { status: speculative }\n~ a claim that stands alone\n";
+
+/// A bare `check`, with neither a path nor `--store`, reads `.smysl/store` in the current
+/// directory rather than blocking on stdin.
+#[test]
+fn no_path_checks_dot_smysl_store() {
+    let dir = scratch("present");
+    std::fs::create_dir_all(dir.join(".smysl")).expect("mkdir .smysl");
+    std::fs::write(dir.join(".smysl").join("store"), A_CLAIM).expect("write store");
+
+    let out = run_in(&dir, &["check"]);
+    assert_eq!(out.code, SUCCESS, "{}", out.stderr);
+    assert!(
+        out.stdout.contains(".smysl/store"),
+        "the summary line must name the store it checked: {}",
+        out.stdout
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// With no `.smysl/store` to find, `check` reports that plainly instead of hanging on stdin —
+/// stdin is `/dev/null` here, so a wrongly-defaulted `check` would fail differently (an empty,
+/// unparseable document) rather than pass.
+#[test]
+fn no_path_and_no_store_fails_naming_the_default_path() {
+    let dir = scratch("absent");
+
+    let out = run_in(&dir, &["check"]);
+    assert_eq!(out.code, FAILURE, "{}", out.stderr);
+    assert!(
+        out.stderr.contains(".smysl/store"),
+        "the failure must name the path it looked for: {}",
+        out.stderr
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// `--store` still overrides the default, exactly as it does for every other command.
+#[test]
+fn explicit_store_flag_overrides_the_default() {
+    let dir = scratch("flag");
+    let named = dir.join("named.smy");
+    std::fs::write(&named, A_CLAIM).expect("write store");
+
+    let out = run_in(&dir, &["--store", named.to_str().unwrap(), "check"]);
+    assert_eq!(out.code, SUCCESS, "{}", out.stderr);
+    assert!(
+        out.stdout.contains("named.smy"),
+        "the summary line must name the store from --store: {}",
+        out.stdout
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}

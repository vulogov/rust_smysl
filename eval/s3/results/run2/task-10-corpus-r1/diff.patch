+/// `{major}.{minor}.{patch}` parsed out of a release-notes filename stem.
+///
+/// Not the lexicographic order filenames sort in — that put `1.10.0` between
+/// `1.1.0` and `1.2.0`, which is the defect [`check_ci_covers_the_procedure`]
+/// exists to avoid repeating, including here in its own fallback.
+fn parse_version(v: &str) -> Option<(u64, u64, u64)> {
+    let mut it = v.split('.');
+    Some((
+        it.next()?.parse().ok()?,
+        it.next()?.parse().ok()?,
+        it.next()?.parse().ok()?,
+    ))
+}
+
+/// The release-notes file for the highest version present in `dir`.
+///
+/// `README.md` and any other non-`{version}.md` file are ignored rather than
+/// erroring, so a stray file cannot stop the fallback from finding real notes.
+fn newest_notes_file(dir: &Path) -> Option<std::path::PathBuf> {
+    let rd = std::fs::read_dir(dir).ok()?;
+    rd.flatten()
+        .filter(|e| e.path().extension().and_then(|x| x.to_str()) == Some("md"))
+        .filter_map(|e| {
+            let stem = e.path().file_stem()?.to_str()?.to_string();
+            let v = parse_version(&stem)?;
+            Some((v, e.path()))
+        })
+        .max_by_key(|(v, _)| *v)
+        .map(|(_, p)| p)
+}

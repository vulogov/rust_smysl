@@ -0,0 +1,65 @@
+//! `smysl trace` with no uid: the walk starts from every root of every view instead.
+//!
+//! The positional uid used to be required, so there was no way to ask "trace from wherever
+//! this store already says its roots are" without first looking the roots up through `view`
+//! and typing one back in. `--store` puts the path on the global flag rather than the
+//! subcommand's own positional, which is what leaves the uid slot empty for clap to fill in.
+
+#![cfg(feature = "cli")]
+
+use std::process::{Command, Output};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const STORE: &str = "fixtures/corpus/F1-incident.smy";
+// `v/f1`'s one root, `f/root-cause`.
+const ROOT: &str = "b3:js4xzessu5zwjpv2rawtugnuvj";
+
+fn run(args: &[&str]) -> Output {
+    Command::new(BIN)
+        .args(args)
+        .output()
+        .expect("the binary under test must run")
+}
+
+#[test]
+fn no_uid_traces_from_the_stores_view_roots() {
+    let explicit = run(&["trace", ROOT, STORE]);
+    let defaulted = run(&["--store", STORE, "trace"]);
+    assert!(
+        explicit.status.success(),
+        "{}",
+        String::from_utf8_lossy(&explicit.stderr)
+    );
+    assert!(
+        defaulted.status.success(),
+        "{}",
+        String::from_utf8_lossy(&defaulted.stderr)
+    );
+    assert_eq!(
+        explicit.stdout, defaulted.stdout,
+        "the default and the explicit root walk the same lineage"
+    );
+}
+
+#[test]
+fn no_uid_and_no_view_is_a_usage_error() {
+    let dir = std::env::temp_dir().join(format!("smysl-trace-no-view-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let f = dir.join("no-view.smy");
+    std::fs::write(
+        &f,
+        "@evidence e/x { status: measured, source: { kind: metric, ref: \"m\", captured: 2026-07-09 } }\n~ A store with no view to default from.\n",
+    )
+    .unwrap();
+
+    let out = run(&["--store", f.to_str().unwrap(), "trace"]);
+    std::fs::remove_dir_all(&dir).ok();
+
+    assert_eq!(out.status.code(), Some(2), "Usage");
+    assert!(
+        String::from_utf8_lossy(&out.stderr)
+            .contains("no uid given and the store declares no view"),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}

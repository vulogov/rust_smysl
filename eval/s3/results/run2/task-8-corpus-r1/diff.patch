 /// So a reading never goes backwards, and the clock still tracks the system
 /// forwards. Those are the two properties; neither is a claim about accuracy.
 ///
+/// # Smoothing how a forward step arrives
+///
+/// Winning is not the same as arriving all at once. `ucal wallclock` renders a
+/// face, and a forward step large enough to matter — an operator setting the
+/// date, a VM resuming after being suspended for hours — would otherwise land
+/// as a single frame skipping straight to the correction. [`MAX_CATCHUP_FACTOR`]
+/// bounds how far one reading may advance past the last one: no more than that
+/// many multiples of the real (monotonic) time elapsed since the previous
+/// reading. A backward step is unaffected, because the monotonic branch already
+/// advances at exactly the oscillator's rate and never needed capping. A large
+/// forward step is instead spread over the following readings — the face runs
+/// fast for a moment rather than jumping — until it lands on the correction and
+/// tracking resumes at the ordinary rate. Nothing is refused: the same value is
+/// still reached, only the rate at which this process's own readings may move
+/// towards it is bounded.
+///
 /// # What it does not do
 ///
 /// It does not make a reading finer, more accurate, or traceable to anything.
@@ -121,14 +137,33 @@ pub struct Session {
     anchor: Ticks,
     /// The largest reading handed out so far.
     last: Ticks,
+    /// The `monotonic_elapsed` passed to the reading that produced `last`.
+    ///
+    /// Subtracting it from the next `monotonic_elapsed` gives the real time
+    /// elapsed since the last reading, which is what bounds how far this one
+    /// may advance — see [`MAX_CATCHUP_FACTOR`].
+    last_elapsed: Ticks,
 }
 
+/// How many multiples of the real elapsed time one reading may advance by.
+///
+/// An integer rather than a rate expressed as a decimal (Rule R forbids a
+/// float in a shipped crate): a reading may move at most this many times as
+/// fast as real time while closing a gap opened by a forward step. `1` would
+/// never close a gap at all — the capped branch would advance at exactly the
+/// rate the wall clock itself moves at after the step, running parallel to it
+/// forever rather than catching up. `2` is the smallest integer above that
+/// floor: enough to guarantee convergence, without inventing a larger number
+/// nothing here justifies.
+const MAX_CATCHUP_FACTOR: u64 = 2;
+
 impl Session {
     /// Anchor a session at a wall reading.
     pub fn anchored_at(wall: &Instant<UC1>) -> Session {
         Session {
             anchor: wall.ticks().clone(),
             last: wall.ticks().clone(),
+            last_elapsed: <Ticks as TickInt>::zero(),
         }
     }
 
@@ -156,7 +191,24 @@ impl Session {
         if self.last > best {
             best = self.last.clone();
         }
+        // Cap how far past `last` this one reading may go. `dt` is the real
+        // time elapsed since the reading that produced `last`; a caller handing
+        // back a smaller `monotonic_elapsed` than before has no real elapsed
+        // time to spend, so `dt` is zero and `best` is capped to `last` itself
+        // — still monotonic, just not advanced this time.
+        let dt = monotonic_elapsed
+            .try_sub(&self.last_elapsed)
+            .unwrap_or_else(<Ticks as TickInt>::zero);
+        let factor = <Ticks as TickInt>::from_u64(MAX_CATCHUP_FACTOR);
+        if let Some(allowance) = dt.try_mul(&factor) {
+            if let Some(ceiling) = self.last.try_add(&allowance) {
+                if best > ceiling {
+                    best = ceiling;
+                }
+            }
+        }
         self.last = best.clone();
+        self.last_elapsed = monotonic_elapsed.clone();
         Instant::from_ticks(best)
     }
 

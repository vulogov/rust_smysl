diff --git a/tests/cmd_usage.rs b/tests/cmd_usage.rs
new file mode 100644
index 0000000..35d43e2
--- /dev/null
+++ b/tests/cmd_usage.rs
@@ -0,0 +1,128 @@
+//! `smysl usage` reads and writes one ledger under the user's home directory, not one per
+//! project — so cost tracked while working in one checkout is still there in another.
+//!
+//! Every test here sets `HOME` to a scratch directory of its own, never the real one: the
+//! ledger would otherwise be written to the developer's actual `~/.smysl/usage.log`.
+
+#![cfg(all(feature = "cli", feature = "ingest"))]
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+/// Run the binary from `dir`, with `home` as its `HOME` — the two are independent, since the
+/// whole point is that the ledger does not follow the working directory.
+fn run(dir: &Path, home: &Path, args: &[&str]) -> Out {
+    let o = Command::new(BIN)
+        .current_dir(dir)
+        .env("HOME", home)
+        .args(args)
+        .stdin(Stdio::null())
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+/// A directory of this test's own, named for the process, so two runs cannot collide.
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-cmd-usage-{name}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+/// A chunk of prose that ingests as one unit, degrading to opaque prose because no provider is
+/// reachable — see `Documentation/manual/ch09-10-attest-providers.typ`'s own walkthrough of the
+/// same path. The point here is only that ingest still records the attempt in the ledger.
+fn ingest_something(dir: &Path, home: &Path) -> Out {
+    let input = dir.join("doc.txt");
+    std::fs::write(&input, "The auth service saw a latency regression.").unwrap();
+    run(dir, home, &["ingest", "--yes", input.to_str().unwrap()])
+}
+
+#[test]
+fn an_empty_home_ledger_reports_no_calls_and_names_the_home_path() {
+    let home = scratch("empty-home");
+    let proj = scratch("empty-proj");
+    let out = run(&proj, &home, &["usage"]);
+    assert_eq!(out.code, 0, "stderr: {}", out.stderr);
+    assert!(
+        out.stdout.contains("no model calls recorded"),
+        "{}",
+        out.stdout
+    );
+    assert!(
+        !home.join(".smysl/usage.log").exists(),
+        "reading an empty ledger must not create the file"
+    );
+}
+
+/// The ledger is not written under the project the command happened to run from.
+#[test]
+fn ingest_writes_the_ledger_under_home_rather_than_the_project() {
+    let home = scratch("write-home");
+    let proj = scratch("write-proj");
+    let out = ingest_something(&proj, &home);
+    assert_eq!(out.code, 0, "stderr: {}", out.stderr);
+
+    assert!(
+        home.join(".smysl/usage.log").exists(),
+        "the ledger should be under $HOME"
+    );
+    assert!(
+        !proj.join(".smysl/usage.log").exists(),
+        "the ledger should not be under the project directory"
+    );
+}
+
+/// The whole point: one ledger, shared by every project on the same machine.
+#[test]
+fn usage_recorded_in_one_project_is_visible_from_another() {
+    let home = scratch("shared-home");
+    let proj_a = scratch("shared-proj-a");
+    let proj_b = scratch("shared-proj-b");
+
+    let ingested = ingest_something(&proj_a, &home);
+    assert_eq!(ingested.code, 0, "stderr: {}", ingested.stderr);
+
+    let seen_from_b = run(&proj_b, &home, &["usage"]);
+    assert_eq!(seen_from_b.code, 0, "stderr: {}", seen_from_b.stderr);
+    assert!(
+        seen_from_b.stdout.contains("1 call(s)"),
+        "a call recorded from project a must be visible from project b: {}",
+        seen_from_b.stdout
+    );
+}
+
+/// `--reset` from any project clears the one shared ledger.
+#[test]
+fn reset_from_a_different_project_still_clears_the_shared_ledger() {
+    let home = scratch("reset-home");
+    let proj_a = scratch("reset-proj-a");
+    let proj_b = scratch("reset-proj-b");
+
+    let ingested = ingest_something(&proj_a, &home);
+    assert_eq!(ingested.code, 0, "stderr: {}", ingested.stderr);
+
+    let reset = run(&proj_b, &home, &["usage", "--reset"]);
+    assert_eq!(reset.code, 0, "stderr: {}", reset.stderr);
+    assert!(
+        reset.stdout.contains("discarded 1 entr(ies)"),
+        "{}",
+        reset.stdout
+    );
+    assert!(!home.join(".smysl/usage.log").exists());
+
+    let after = run(&proj_a, &home, &["usage"]);
+    assert!(after.stdout.contains("no model calls recorded"));
+}

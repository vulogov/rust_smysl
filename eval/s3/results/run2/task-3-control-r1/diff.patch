+    /// `HOME`/`USERPROFILE` are process-global, so this is the one test that touches them -
+    /// sequentially, in a single test function, restoring both at the end, so no other test
+    /// in this binary can observe them mid-change.
+    #[test]
+    fn default_path_lives_under_the_users_home() {
+        let home_before = std::env::var_os("HOME");
+        let profile_before = std::env::var_os("USERPROFILE");
+
+        std::env::set_var("HOME", "/home/example");
+        assert_eq!(
+            Ledger::default_path(),
+            Some(PathBuf::from("/home/example/.smysl/usage.log")),
+            "HOME wins when set"
+        );
+
+        std::env::set_var("USERPROFILE", "C:\\Users\\example");
+        assert_eq!(
+            Ledger::default_path(),
+            Some(PathBuf::from("/home/example/.smysl/usage.log")),
+            "HOME wins over USERPROFILE when both are set"
+        );
+
+        std::env::remove_var("HOME");
+        assert_eq!(
+            Ledger::default_path(),
+            Some(
+                PathBuf::from("C:\\Users\\example")
+                    .join(".smysl")
+                    .join("usage.log")
+            ),
+            "USERPROFILE is the fallback"
+        );
+
+        std::env::remove_var("USERPROFILE");
+        assert_eq!(
+            Ledger::default_path(),
+            None,
+            "no default rather than a guessed location"
+        );
+
+        match home_before {
+            Some(v) => std::env::set_var("HOME", v),
+            None => std::env::remove_var("HOME"),
+        }
+        match profile_before {
+            Some(v) => std::env::set_var("USERPROFILE", v),
+            None => std::env::remove_var("USERPROFILE"),
+        }
+    }
 }

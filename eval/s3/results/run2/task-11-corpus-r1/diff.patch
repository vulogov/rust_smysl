+//! Shared by every test that needs the synthetic `ephem residuals`
+//! observations. `1.12.0` committed these to `Documentation/examples/
+//! observations.txt` after two test binaries wrote the same fixed temp path
+//! concurrently and raced; the actual fix is a unique path per write, not a
+//! committed file, so each caller here gets its own.
+
+/// Four synthetic instants: the predicted centres of cycles 0, 100, 250 and
+/// 500 in `Documentation/examples/ephemeris.hjson`, moved by 0, +3, -7 and
+/// +41 seconds, so the residuals are known in advance and can be checked by
+/// eye — the last is outside its own window and the others are not.
+pub const OBSERVATIONS: &str = "\
+# cycle 0, +0 s
+8070205175623907873429294080830071880530466139316558837890624
+
+# cycle 100, +3 s
+8070205176188783324648635603786425480530466139316558837890624
+
+# cycle 250, -7 s
+8070205177036096232523174090236455880530466139316558837890624
+
+# cycle 500, +41 s
+8070205178448285611789196091997839880530466139316558837890624
+";
+
+/// A temp file holding [`OBSERVATIONS`], at a path unique to this call.
+///
+/// Named by pid *and* a per-process counter: the pid alone is not enough
+/// because `#[test]` functions in one binary run concurrently and share it —
+/// which is exactly the race `1.12.0`'s committed fixture papered over.
+pub struct TempObservations(std::path::PathBuf);
+
+impl TempObservations {
+    pub fn write() -> TempObservations {
+        static COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        let n = COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let mut path = std::env::temp_dir();
+        path.push(format!("ucal-observations-{}-{n}.txt", std::process::id()));
+        std::fs::write(&path, OBSERVATIONS).expect("write synthetic observations");
+        TempObservations(path)
+    }
+
+    pub fn path(&self) -> &str {
+        self.0.to_str().expect("utf-8 temp path")
+    }
+}
+
+impl Drop for TempObservations {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}

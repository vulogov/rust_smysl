+/// Synthetic observations for the `ephem residuals` example: the predicted
+/// centres of cycles 0, 100, 250 and 500 in `ephemeris.hjson`, moved by 0,
+/// +3, -7 and +41 seconds, so the residuals shown are known in advance and
+/// can be checked by eye. Kept identical to `crates/ucal/tests/common/mod.rs`
+/// so the two agree on what "the synthetic observations" are.
+const OBSERVATIONS: &str = "\
+# cycle 0, +0 s
+8070205175623907873429294080830071880530466139316558837890624
+
+# cycle 100, +3 s
+8070205176188783324648635603786425480530466139316558837890624
+
+# cycle 250, -7 s
+8070205177036096232523174090236455880530466139316558837890624
+
+# cycle 500, +41 s
+8070205178448285611789196091997839880530466139316558837890624
+";
+
+/// Write the observations fixture at the path the `ephem residuals` example
+/// names, so that example — like every other one — can be captured by
+/// running the real binary against a real file. Not committed: a fixed
+/// committed path here raced two test binaries that wrote it concurrently
+/// (see `crates/ucal/tests/common/mod.rs`), so it is generated instead, the
+/// same way `CLI-EXAMPLES.md` itself is.
+fn ensure_observations(root: &Path) -> Result<(), String> {
+    let path = root.join("Documentation/examples/observations.txt");
+    std::fs::write(&path, OBSERVATIONS).map_err(|e| format!("{}: {e}", path.display()))
+}

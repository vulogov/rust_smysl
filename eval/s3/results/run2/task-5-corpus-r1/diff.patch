+//! `trace`'s uid is optional. Omitted, it walks from every root of every view (§16.4) — the
+//! same seed set `salience` and `thread --derive` already default to when nothing else names
+//! a starting point.
+//!
+//! The uid positional stayed first and the store positional second, so a single bare argument
+//! still fills `uid` before `store`. `smysl trace some-store.smy` would otherwise be read as an
+//! attempt to trace the label `some-store.smy` rather than as "trace this store, uid omitted" —
+//! the property pinned here is that it is not.
+
+#![cfg(feature = "cli")]
+
+use std::path::PathBuf;
+use std::process::{Command, Output};
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const STORE: &str = "fixtures/corpus/F1-incident.smy";
+const ROOT: &str = "b3:js4xzessu5zwjpv2rawtugnuvj";
+
+fn run(args: &[&str]) -> Output {
+    Command::new(BIN)
+        .args(args)
+        .output()
+        .expect("the binary under test must run")
+}
+
+fn scratch(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!(
+        "smysl-trace-default-roots-{name}-{}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+#[test]
+fn omitting_the_uid_traces_the_stores_declared_root() {
+    let explicit = run(&["trace", ROOT, STORE]);
+    let defaulted = run(&["trace", STORE]);
+    assert!(
+        explicit.status.success(),
+        "{}",
+        String::from_utf8_lossy(&explicit.stderr)
+    );
+    assert_eq!(explicit.status.code(), defaulted.status.code());
+    assert_eq!(
+        String::from_utf8_lossy(&explicit.stdout),
+        String::from_utf8_lossy(&defaulted.stdout),
+        "defaulting to the root must print exactly what naming it explicitly does"
+    );
+}
+
+#[test]
+fn omitting_the_uid_still_works_under_json() {
+    let explicit = run(&["trace", "--json", ROOT, STORE]);
+    let defaulted = run(&["trace", "--json", STORE]);
+    assert!(defaulted.status.success());
+    assert_eq!(
+        String::from_utf8_lossy(&explicit.stdout),
+        String::from_utf8_lossy(&defaulted.stdout)
+    );
+}
+
+/// Nothing is given at all — not even a store. Distinct from the "uid given, store missing"
+/// case below: this is the one clap itself now lets through, since neither positional is
+/// required any more.
+#[test]
+fn no_uid_and_no_store_is_refused() {
+    let out = run(&["trace"]);
+    assert!(!out.status.success());
+    assert!(String::from_utf8_lossy(&out.stderr).contains("no store given"));
+}
+
+/// A lone argument shaped like a label is still read as the uid, not as a store path —
+/// the ambiguity is broken by shape, not by position.
+#[test]
+fn a_label_shaped_lone_argument_is_read_as_a_uid_not_a_store() {
+    let out = run(&["trace", "c/pool-saturation"]);
+    assert!(!out.status.success());
+    assert!(
+        String::from_utf8_lossy(&out.stderr).contains("no store given"),
+        "`c/pool-saturation` looks like a label, so the missing argument is the store, not the uid"
+    );
+}
+
+/// A store with two roots is walked from both, one trace block per root, in the same order
+/// `view`'s own `BTreeSet<Uid>` would give them.
+#[test]
+fn omitting_the_uid_walks_every_view_root_when_there_are_several() {
+    let dir = scratch("multi");
+    let f = dir.join("two-roots.smy");
+    std::fs::write(
+        &f,
+        "\
+@doc smysl/1.0 { id: v/two-roots, intent: rationale, lang: en, roots: [c/one, c/two] }
+
+@claim c/one { status: speculative }
+~ First independent claim.
+
+@claim c/two { status: speculative }
+~ Second independent claim.
+",
+    )
+    .unwrap();
+    let path = f.to_str().unwrap();
+
+    let defaulted = run(&["trace", path]);
+    assert!(
+        defaulted.status.success(),
+        "{}",
+        String::from_utf8_lossy(&defaulted.stderr)
+    );
+    let by_one = run(&["trace", "c/one", path]);
+    let by_two = run(&["trace", "c/two", path]);
+    assert!(by_one.status.success() && by_two.status.success());
+
+    let stdout = String::from_utf8_lossy(&defaulted.stdout).into_owned();
+    let expected = format!(
+        "{}{}",
+        String::from_utf8_lossy(&by_one.stdout),
+        String::from_utf8_lossy(&by_two.stdout)
+    );
+    assert_eq!(
+        stdout, expected,
+        "the two single-root traces, concatenated in root order, are exactly the default output"
+    );
+
+    std::fs::remove_dir_all(&dir).ok();
+}
+
+/// A store that declares no view has no roots to default to, and `trace` refuses rather than
+/// silently walking nothing.
+#[test]
+fn omitting_the_uid_with_no_view_roots_is_refused() {
+    let dir = scratch("no-view");
+    let f = dir.join("no-view.smy");
+    std::fs::write(
+        &f,
+        "\
+@claim c/only { status: speculative }
+~ A store with no view at all.
+",
+    )
+    .unwrap();
+    let out = run(&["trace", f.to_str().unwrap()]);
+    std::fs::remove_dir_all(&dir).ok();
+
+    assert!(!out.status.success());
+    assert!(
+        String::from_utf8_lossy(&out.stderr)
+            .contains("no uid given and the store declares no view roots"),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}

+    /// **Anchoring at start is idempotent.** A second call — the one every
+    /// later `now` makes through [`session_now`] — must not move the anchor.
+    ///
+    /// Touches the process-wide session, so this is the only test in this
+    /// module that does; splitting it across two `#[test]` functions would let
+    /// the test harness's own parallelism race one against the other.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn anchoring_at_start_is_idempotent() {
+        anchor_at_start().expect("anchors on first call");
+        let anchor_after_first = {
+            let g = session().lock().expect("session lock");
+            g.as_ref().expect("anchored").0.anchor.clone()
+        };
+
+        // A later call — standing in for `session_now`'s own fallback, and for
+        // a second, mistaken call to `anchor_at_start` itself — must find the
+        // session already anchored and leave it alone.
+        anchor_at_start().expect("anchors again cleanly");
+        let anchor_after_second = {
+            let g = session().lock().expect("session lock");
+            g.as_ref().expect("still anchored").0.anchor.clone()
+        };
+
+        assert_eq!(
+            anchor_after_first.to_dec_string(),
+            anchor_after_second.to_dec_string(),
+            "a later call moved the anchor instead of leaving it alone"
+        );
+    }

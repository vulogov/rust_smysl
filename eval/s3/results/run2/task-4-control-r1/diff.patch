+/// `--check` reads stdin like any other input when no file is named, and names it `-` in
+/// the diagnostic — the same as every other command that takes `-` for "no path given".
+///
+/// Every `--check` test above names a file on the command line; nothing here had piped a
+/// document through `fmt --check` before, so a mutant that only mishandled the `path == "-"`
+/// leg of `read_bytes` would have nothing to catch it.
+#[test]
+fn check_reads_an_unformatted_document_from_stdin() {
+    let loose = "@claim c/a {  status: speculative  }\n~ a claim with loose spacing\n";
+
+    let unformatted = run_stdin(&["fmt", "--check"], loose);
+    assert_eq!(
+        unformatted.code, CHECK_ERRORS,
+        "an unformatted document on stdin must fail --check: {}",
+        unformatted.stderr
+    );
+    assert!(
+        unformatted.stderr.contains("not canonically formatted"),
+        "{}",
+        unformatted.stderr
+    );
+
+    // The control: the document's own canonical form, still piped in, passes.
+    let formatted = run_stdin(&["fmt"], loose);
+    assert_eq!(formatted.code, SUCCESS, "{}", formatted.stderr);
+    let ok = run_stdin(&["fmt", "--check"], &formatted.stdout);
+    assert_eq!(
+        ok.code, SUCCESS,
+        "a canonical document on stdin must pass --check: {}",
+        ok.stderr
+    );
+    assert!(!ok.stderr.contains("not canonically formatted"));
+}

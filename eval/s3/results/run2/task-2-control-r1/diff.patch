@@ -0,0 +1,104 @@
+//! `smysl check` with no `FILE` and no `--store`.
+//!
+//! Every other bare command falls back to stdin (rule P), and `check` used to as well - which
+//! meant a scheduled or pre-commit `smysl check` with nothing piped into it either hung reading
+//! a terminal or silently checked an empty document. `check` alone now defaults to the store a
+//! project keeps at `.smysl/store`, resolved against the current directory the way every other
+//! project sidecar is (`ingest`'s `.smysl/staged.smy`, `usage`'s `.smysl/usage.log`).
+
+#![cfg(feature = "cli")]
+
+use std::process::Command;
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+const F1: &str = "fixtures/corpus/F1-incident.smy";
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+fn run_in(dir: &std::path::Path, args: &[&str]) -> Out {
+    let o = Command::new(BIN)
+        .args(args)
+        .current_dir(dir)
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+/// A directory of this test's own, so two runs cannot collide and no test depends on -
+/// or dirties - the state of the checkout.
+fn scratch(name: &str) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-cmd-check-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(dir.join(".smysl")).expect("scratch dir");
+    dir
+}
+
+const SUCCESS: i32 = 0;
+const FAILURE: i32 = 1;
+
+/// No `FILE`, no `--store`, and `.smysl/store` present: `check` reads it, the same as if it
+/// had been named explicitly.
+#[test]
+fn no_path_reads_dot_smysl_store() {
+    let dir = scratch("present");
+    let src = std::fs::read_to_string(F1).expect("read fixture");
+    std::fs::write(dir.join(".smysl").join("store"), &src).expect("write default store");
+
+    let bare = run_in(&dir, &["check"]);
+    let explicit = run_in(&dir, &["check", ".smysl/store"]);
+
+    assert_eq!(
+        bare.code, SUCCESS,
+        "a clean store at the default path should check clean: {} {}",
+        bare.stdout, bare.stderr
+    );
+    // Both runs name the same path (`.smysl/store`, once implied and once spelled out), so
+    // they report identically.
+    assert_eq!(bare.stdout, explicit.stdout);
+}
+
+/// No `FILE`, no `--store`, and no `.smysl/store` on disk: `check` reports the missing file
+/// rather than blocking on stdin - a run under a test harness or a cron job has nothing to
+/// pipe in, and hanging is worse than failing.
+#[test]
+fn no_path_and_no_default_store_fails_without_blocking_on_stdin() {
+    let dir = scratch("absent");
+
+    let out = run_in(&dir, &["check"]);
+
+    assert_eq!(
+        out.code, FAILURE,
+        "a missing default store must fail, not hang or succeed: {} {}",
+        out.stdout, out.stderr
+    );
+    assert!(
+        out.stderr.contains(".smysl/store"),
+        "the error should name the path it looked for: {}",
+        out.stderr
+    );
+}
+
+/// `--store` still overrides the default, exactly as it does for every other command.
+#[test]
+fn explicit_store_flag_overrides_the_default() {
+    let dir = scratch("flag");
+    let src = std::fs::read_to_string(F1).expect("read fixture");
+    let named = dir.join("named.smy");
+    std::fs::write(&named, &src).expect("write named store");
+
+    let out = run_in(&dir, &["check", "--store", "named.smy"]);
+
+    assert_eq!(
+        out.code, SUCCESS,
+        "an explicit --store must be read instead of the default: {} {}",
+        out.stdout, out.stderr
+    );
+}

+    #[test]
+    fn a_large_forward_step_is_capped_then_caught_up_by_elapsed_time() {
+        let mut s = Session::anchored_at(&at(100));
+        s.reading(&at(101), &ns(1_000_000_000)).expect("a reading");
+
+        // The wall clock jumps sixty seconds ahead of the monotonic
+        // projection (102s): capped to one second above it.

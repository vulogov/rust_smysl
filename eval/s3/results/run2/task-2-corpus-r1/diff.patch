+//! `smysl check` with no path at all.
+//!
+//! Every other command with no path reads stdin (rule P). `check` is the one command a
+//! caller runs unattended over "the project" rather than over one document handed to it on a
+//! pipe, so with neither a positional file nor `--store` it now looks for the project's store
+//! at the fixed path `.smysl/store`, relative to the working directory.
+
+// The binary only exists with `cli`, and a test that cannot find its subject is worse than one
+// that is not there.
+#![cfg(feature = "cli")]
+
+use std::process::Command;
+use std::process::Stdio;
+
+const BIN: &str = env!("CARGO_BIN_EXE_smysl");
+
+struct Out {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+/// Run `check` with no arguments, from a directory of its own, stdin closed rather than
+/// inherited — a store missing entirely is the point of these tests, not a hang on a
+/// terminal that never sends EOF.
+fn run_bare(dir: &std::path::Path) -> Out {
+    let o = Command::new(BIN)
+        .arg("check")
+        .current_dir(dir)
+        .stdin(Stdio::null())
+        .output()
+        .expect("the binary under test must run");
+    Out {
+        stdout: String::from_utf8_lossy(&o.stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&o.stderr).into_owned(),
+        code: o.status.code().unwrap_or(-1),
+    }
+}
+
+fn scratch(name: &str) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("smysl-check-default-{name}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("scratch dir");
+    dir
+}
+
+/// With no `.smysl/store` present, `check` names that path rather than silently reading an
+/// empty stdin — the failure has to say what it was looking for, or a typo'd working
+/// directory looks the same as a clean project.
+#[test]
+fn with_no_path_and_no_store_it_looks_for_dot_smysl_store() {
+    let dir = scratch("missing");
+    let out = run_bare(&dir);
+    assert_ne!(out.code, 0, "no store present: {}", out.stdout);
+    assert!(
+        out.stderr.contains(".smysl/store"),
+        "the failure must name the path it looked for: {}",
+        out.stderr
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// A `.smysl/store` beside the working directory is what a bare `check` reads — the same file
+/// a project's other sidecars (`.smysl/staged.smy`, `.smysl/config.hjson`) sit next to.
+#[test]
+fn with_no_path_and_no_store_it_reads_dot_smysl_store() {
+    let dir = scratch("present");
+    let smysl_dir = dir.join(".smysl");
+    std::fs::create_dir_all(&smysl_dir).expect("create .smysl");
+    std::fs::write(
+        smysl_dir.join("store"),
+        "@claim c/a { status: speculative }\n~ a claim that stands alone\n",
+    )
+    .expect("write store");
+
+    let out = run_bare(&dir);
+    assert_eq!(out.code, 0, "a clean store must pass: {}", out.stderr);
+    assert!(
+        out.stdout.contains(".smysl/store"),
+        "the report must name the path it read: {}",
+        out.stdout
+    );
+    assert!(
+        out.stdout.contains("1 units"),
+        "and reflect the one unit it found: {}",
+        out.stdout
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// An explicit `-` still reads stdin, and an explicit `--store` still takes that path — the
+/// new default only fills the gap when neither is given.
+#[test]
+fn an_explicit_path_or_store_flag_is_unaffected() {
+    let dir = scratch("explicit");
+
+    let o = Command::new(BIN)
+        .args(["check", "-"])
+        .current_dir(&dir)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn");
+    use std::io::Write;
+    o.stdin
+        .as_ref()
+        .unwrap()
+        .write_all(b"")
+        .expect("write stdin");
+    let out = o.wait_with_output().expect("wait");
+    assert_eq!(
+        out.status.code(),
+        Some(0),
+        "explicit `-` reads stdin, not .smysl/store: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+
+    let elsewhere = dir.join("elsewhere.smy");
+    std::fs::write(
+        &elsewhere,
+        "@claim c/a { status: speculative }\n~ a claim that stands alone\n",
+    )
+    .expect("write");
+    let out = Command::new(BIN)
+        .args(["--store", elsewhere.to_str().unwrap(), "check"])
+        .current_dir(&dir)
+        .stdin(Stdio::null())
+        .output()
+        .expect("run");
+    assert_eq!(
+        out.status.code(),
+        Some(0),
+        "--store names the path explicitly: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}

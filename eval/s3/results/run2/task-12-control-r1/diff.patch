+/// How far a fresh wall reading has diverged from this process's session
+/// clock, sampled now.
+///
+/// Anchors the process-wide session on first use, the same way
+/// [`session_now`] does, so a command that asks for this without ever calling
+/// `now` still gets an answer. Unlike `session_now`, it does not advance the
+/// session: [`Session::divergence`] takes `&self`, so asking does not consume
+/// a reading.
+///
+/// For a one-shot command the session is anchored moments before this reads
+/// it, so the honest answer is the two clocks agreeing to a few nanoseconds —
+/// the cost of locking the mutex and reading `Instant::elapsed` in between.
+/// `ucal wallclock` holds one session open for as long as it runs, and that is
+/// where a real rate difference between the two clocks would show.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn session_drift() -> Result<(Ticks, bool), TimeError> {
+    let wall = crate::wall_instant()?;
+    let mut g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let (sess, base) = g.get_or_insert_with(|| (Session::anchored_at(&wall), std::time::Instant::now()));
+    let elapsed = ticks_in_nanos(base.elapsed().as_nanos())
+        .ok_or_else(|| TimeError::new(ucal_core::Code::E0021))?;
+    Ok(sess.divergence(&wall, &elapsed))
+}
+
+/// The reverse of [`ticks_in_nanos`]: whole nanoseconds spanned by `t`,
+/// truncating any remainder finer than a nanosecond. `None` if the count does
+/// not fit a `u128`, which a drift never does in practice but the type has to
+/// allow for.
+#[cfg(all(feature = "std", feature = "civil"))]
+fn nanos_in_ticks(t: &Ticks) -> Option<u128> {
+    let per_second = UC1::bridge().ticks;
+    let billion = <Ticks as TickInt>::from_u64(1_000_000_000);
+    let (per_nano, _) = per_second.quot_rem(&billion);
+    let (q, _) = t.quot_rem(&per_nano);
+    q.to_dec_string().parse().ok()
+}
+

+    // ---- session drift ---------------------------------------------------
+
+    /// `nanos_in_ticks` is the exact inverse of `ticks_in_nanos`: a nanosecond
+    /// count divides back out of the ticks it was multiplied into (Rule R).
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn nanos_in_ticks_is_the_inverse_of_ticks_in_nanos() {
+        for n in [0u128, 1, 1_000, 999_999_999, 123_456_789] {
+            let t = ticks_in_nanos(n).expect("in range");
+            assert_eq!(nanos_in_ticks(&t), Some(n));
+        }
+    }
+
+    /// The process-wide session answers a drift query without ever having
+    /// been read through [`session_now`] first, and the answer is bounded:
+    /// this test's own process has not been running long enough for the two
+    /// clocks to have drifted seconds apart.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn session_drift_answers_even_if_the_session_was_never_read() {
+        let (drift, _wall_ahead) = session_drift().expect("a drift reading");
+        let ns = nanos_in_ticks(&drift).expect("fits a u128 of nanoseconds");
+        assert!(
+            ns < 10_000_000_000,
+            "a test process should not have drifted 10s from the wall clock: {ns} ns"
+        );
+    }
+
+    /// `measured()` — what `doctor --clock` prints — carries the drift too.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn the_measurement_reports_session_drift() {
+        let m = measured().expect("measured");
+        let (_, v) = m
+            .iter()
+            .find(|(k, _)| k == "session_drift")
+            .expect("no `session_drift`");
+        assert!(
+            v.rendered_text().contains("ns"),
+            "session_drift observed nothing: {}",
+            v.rendered_text()
+        );
+    }

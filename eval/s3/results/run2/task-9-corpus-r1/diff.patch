+/// The Contents table must list rows newest-first, by parsed semantic version.
+///
+/// The table is hand-edited, and a version is three numbers compared
+/// pairwise, not a string: `1.9.0` sorts *after* `1.10.0` lexicographically
+/// but is older. Checking the parsed order rather than trusting the table's
+/// position catches a row inserted in the wrong place — the same class of
+/// mistake `check_ci_covers_the_procedure` stopped guessing at, here applied
+/// to the table a person, not a sort, maintains.
+fn check_sorted(rows: &[Row]) -> Result<(), String> {
+    let mut prev: Option<(&str, (u64, u64, u64))> = None;
+    for row in rows {
+        let v = parse_version(&row.version)
+            .ok_or_else(|| format!("{} is not a parseable `major.minor.patch` version", row.version))?;
+        if let Some((prev_version, prev_v)) = prev {
+            if v >= prev_v {
+                return Err(format!(
+                    "{} is listed below {prev_version} but is not older; the Contents \
+                     table must be sorted newest-first by version",
+                    row.version
+                ));
+            }
+        }
+        prev = Some((&row.version, v));
+    }
+    Ok(())
+}

+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn row(version: &str) -> Row {
+        Row {
+            version: version.to_string(),
+            state: "released".to_string(),
+        }
+    }
+
+    #[test]
+    fn newest_first_is_accepted() {
+        let rows = [row("1.10.0"), row("1.9.0"), row("1.2.0"), row("1.1.0")];
+        assert!(check_sorted(&rows).is_ok());
+    }
+
+    /// `1.9.0` sorts after `1.10.0` as text; a check comparing strings rather
+    /// than the parsed number would accept this backwards table.
+    #[test]
+    fn lexicographic_order_is_rejected() {
+        let rows = [row("1.9.0"), row("1.10.0")];
+        let e = check_sorted(&rows).expect_err("1.10.0 is newer than 1.9.0");
+        assert!(
+            e.contains("1.10.0"),
+            "message should name the misplaced row: {e}"
+        );
+    }
+
+    #[test]
+    fn a_duplicated_version_is_rejected() {
+        let rows = [row("1.2.0"), row("1.2.0")];
+        assert!(check_sorted(&rows).is_err());
+    }
+
+    #[test]
+    fn an_unparseable_version_is_rejected() {
+        let rows = [row("1.2")];
+        let e = check_sorted(&rows).expect_err("not major.minor.patch");
+        assert!(e.contains("1.2"));
+    }
+
+    /// The real Contents table, maintained by hand, must already satisfy the
+    /// property this check exists to hold it to.
+    #[test]
+    fn the_real_release_notes_table_is_sorted() {
+        let rows = rows(&crate::workspace_root()).expect("README.md parses");
+        assert!(check_sorted(&rows).is_ok());
+    }
+}

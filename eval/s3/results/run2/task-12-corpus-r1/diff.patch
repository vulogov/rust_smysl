+    /// `doctor --clock` reports how far the session clock has drifted from a
+    /// fresh read of the system clock, not just resolution.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn the_measurement_reports_session_drift() {
+        let m = measured().expect("measured");
+        let (_, v) = m
+            .iter()
+            .find(|(k, _)| k == "session_drift")
+            .unwrap_or_else(|| panic!("no `session_drift`"));
+        assert!(
+            v.rendered_text().contains("ns"),
+            "session_drift did not report a magnitude: {}",
+            v.rendered_text()
+        );
+        let (_, ticks) = m
+            .iter()
+            .find(|(k, _)| k == "session_drift_ticks")
+            .unwrap_or_else(|| panic!("no `session_drift_ticks`"));
+        // An exact tick count, not a rendering of one (Rule R): all digits.
+        let rendered = ticks.rendered_text();
+        assert!(
+            !rendered.trim().is_empty() && rendered.trim().chars().all(|c| c.is_ascii_digit()),
+            "session_drift_ticks is not a plain integer: {rendered}"
+        );
+    }
+
+    /// A freshly anchored, quiet session has not had time to drift far from a
+    /// wall reading taken moments later — bounding it catches the projection
+    /// and the fresh reading being computed from unrelated bases.
+    #[cfg(all(feature = "std", feature = "civil"))]
+    #[test]
+    fn session_drift_is_small_for_a_quiet_process() {
+        let (delta, _wall_ahead) = session_drift().expect("session drift");
+        let bound = ticks_in_nanos(2_000_000_000).expect("in range"); // 2 seconds
+        assert!(
+            delta <= bound,
+            "drift was implausibly large for a quiet process: {}",
+            delta.to_dec_string()
+        );
+    }

+/// How far this process's session clock has drifted from a fresh read of the
+/// system clock, right now.
+///
+/// Anchors the session on first use, the same as [`session_now`] — a
+/// diagnostic that asks about the clock is allowed to start the clock it asks
+/// about.
+///
+/// Returns the magnitude in ticks and whether the *wall* clock is ahead of the
+/// session's projection: the same shape [`Session::divergence`] returns,
+/// signed by a word rather than a number because a tick count is unsigned
+/// (Rule B).
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn session_drift() -> Result<(Ticks, bool), TimeError> {
+    let wall = crate::wall_instant()?;
+    let mut g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    let (sess, base) = g.get_or_insert_with(|| {
+        (Session::anchored_at(&wall), std::time::Instant::now())
+    });
+    let elapsed = ticks_in_nanos(base.elapsed().as_nanos())
+        .ok_or_else(|| TimeError::new(ucal_core::Code::E0021))?;
+    Ok(sess.divergence(&wall, &elapsed))
+}

+/// Anchor the process-wide session now, if it has not been anchored already.
+///
+/// `main` calls this once, before dispatching to any command, so **one
+/// process** genuinely means **one anchor** — the wall reading this session's
+/// projections are built from is the one taken at start-up, not whichever
+/// reading a particular command happened to ask for first. Anchoring on first
+/// use instead was tried and rejected: it makes the anchor a property of which
+/// command ran rather than of the process, and `ucal wallclock`'s first frame
+/// and `ucal doctor --clock`'s sampling would then anchor at different moments
+/// depending on which of them a caller happened to run — a session that is not
+/// the same session twice.
+///
+/// Idempotent, so calling it more than once — or not at all, for a library
+/// caller that never goes through `main` — costs nothing extra:
+/// [`session_now`] anchors lazily as a fallback for exactly that caller.
+#[cfg(all(feature = "std", feature = "civil"))]
+pub fn anchor_session() -> Result<(), TimeError> {
+    let wall = crate::wall_instant()?;
+    // A poisoned lock means another thread panicked holding it. The state is a
+    // pair of tick counts and cannot be torn, so taking the inner value is
+    // correct rather than merely convenient — the same judgement
+    // `body_file::leak` makes about its intern pool.
+    let mut g = match session().lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    g.get_or_insert_with(|| (Session::anchored_at(&wall), std::time::Instant::now()));
+    Ok(())
+}
